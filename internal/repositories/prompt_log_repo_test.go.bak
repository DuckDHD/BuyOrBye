package repositories

import (
	"context"
	"fmt"
	"testing"
	"time"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	"gorm.io/driver/sqlite"
	"gorm.io/gorm"

	"github.com/DuckDHD/BuyOrBye/internal/domain"
	"github.com/DuckDHD/BuyOrBye/internal/models"
)

func setupPromptLogTestDB(t *testing.T) *gorm.DB {
	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
	require.NoError(t, err)

	// Auto-migrate prompt log models
	err = db.AutoMigrate(
		&models.AIPromptLogModel{},
	)
	require.NoError(t, err)

	return db
}

func createTestAIPrompt() domain.AIPrompt {
	return domain.AIPrompt{
		SystemContext:    "You are a purchase decision assistant",
		UserContext:      "User has budget of $1000 and looking for electronics",
		PurchaseDetails:  "Item: Laptop, Cost: $800, Category: Electronics",
		DecisionCriteria: "Consider budget, necessity, and value for money",
		ResponseFormat:   "Respond with JSON containing decision and confidence",
		MaxTokens:        500,
		Temperature:      0.7,
	}
}

func createTestAIResponse(decision string, confidence float64) domain.AIResponse {
	return domain.AIResponse{
		RawResponse: fmt.Sprintf(`{"decision": "%s", "confidence": %.2f, "reason": "Test reason"}`, decision, confidence),
		Decision:    decision,
		Confidence:  confidence,
		TokensUsed:  150,
	}
}

// PHASE 1: Prompt Log Repository Tests (RED) - Test cases that should initially fail

func TestPromptLogRepository_LogPrompt_Success(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	prompt := createTestAIPrompt()
	userID := "user-123"
	requestID := "req-456"
	intentID := "intent-789"

	logID, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)

	assert.NoError(t, err)
	assert.NotEmpty(t, logID)

	// Verify record was saved to database
	var count int64
	db.Model(&models.AIPromptLogModel{}).Where("user_id = ? AND request_id = ?", userID, requestID).Count(&count)
	assert.Equal(t, int64(1), count)

	// Verify data integrity
	var record models.AIPromptLogModel
	db.Where("user_id = ? AND request_id = ?", userID, requestID).First(&record)
	assert.Equal(t, userID, record.UserID)
	assert.Equal(t, requestID, record.RequestID)
	assert.Equal(t, intentID, record.IntentID)
	assert.Equal(t, prompt.SystemContext, record.SystemContext)
	assert.Equal(t, prompt.UserContext, record.UserContext)
	assert.Equal(t, prompt.PurchaseDetails, record.PurchaseDetails)
	assert.Equal(t, prompt.DecisionCriteria, record.DecisionCriteria)
	assert.Equal(t, prompt.ResponseFormat, record.ResponseFormat)
	assert.Equal(t, prompt.MaxTokens, record.MaxTokens)
	assert.Equal(t, prompt.Temperature, record.Temperature)
	assert.Greater(t, record.TokensInput, 0) // Should estimate input tokens
	assert.False(t, record.Success)          // Should be false initially
}

func TestPromptLogRepository_LogPrompt_DuplicateRequestID(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	prompt := createTestAIPrompt()
	userID := "user-123"
	requestID := "req-456"
	intentID := "intent-789"

	// First log should succeed
	_, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
	assert.NoError(t, err)

	// Second log with same request ID should be allowed (multiple attempts)
	// But we should track the duplicates
	_, err = repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
	assert.NoError(t, err)

	// Verify both records exist
	var count int64
	db.Model(&models.AIPromptLogModel{}).Where("request_id = ?", requestID).Count(&count)
	assert.Equal(t, int64(2), count)
}

func TestPromptLogRepository_UpdateWithResponse_Success(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// First log the prompt
	prompt := createTestAIPrompt()
	userID := "user-123"
	requestID := "req-456"
	intentID := "intent-789"

	logID, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
	require.NoError(t, err)

	// Then update with response
	response := createTestAIResponse("BUY", 0.85)
	processingTime := int64(2500)

	err = repo.UpdateWithResponse(ctx, logID, response, processingTime)

	assert.NoError(t, err)

	// Verify the update
	var record models.AIPromptLogModel
	db.First(&record, logID)
	assert.Equal(t, response.RawResponse, record.RawResponse)
	assert.Equal(t, response.Decision, record.ParsedDecision)
	assert.Equal(t, response.Confidence, record.ParsedConfidence)
	assert.Equal(t, response.TokensUsed, record.TokensOutput)
	assert.Equal(t, processingTime, record.ProcessingTimeMs)
	assert.True(t, record.Success)
	assert.Greater(t, record.EstimatedCostUSD, 0.0)
	assert.Equal(t, record.TokensInput+response.TokensUsed, record.TokensTotal)
}

func TestPromptLogRepository_UpdateWithError_Success(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// First log the prompt
	prompt := createTestAIPrompt()
	userID := "user-123"
	requestID := "req-456"
	intentID := "intent-789"

	logID, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
	require.NoError(t, err)

	// Then update with error
	testError := fmt.Errorf("API rate limit exceeded")
	statusCode := 429
	processingTime := int64(1500)

	err = repo.UpdateWithError(ctx, logID, testError, statusCode, processingTime)

	assert.NoError(t, err)

	// Verify the error update
	var record models.AIPromptLogModel
	db.First(&record, logID)
	assert.Equal(t, testError.Error(), record.ErrorMessage)
	assert.Equal(t, statusCode, record.StatusCode)
	assert.Equal(t, processingTime, record.ProcessingTimeMs)
	assert.False(t, record.Success)
	assert.Empty(t, record.RawResponse)
	assert.Empty(t, record.ParsedDecision)
	assert.Equal(t, 0.0, record.ParsedConfidence)
}

func TestPromptLogRepository_GetPromptByHash_Deduplication(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// Create prompt and log it with successful response
	prompt := createTestAIPrompt()
	userID := "user-123"
	requestID := "req-456"
	intentID := "intent-789"

	logID, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
	require.NoError(t, err)

	response := createTestAIResponse("BUY", 0.85)
	err = repo.UpdateWithResponse(ctx, logID, response, 2500)
	require.NoError(t, err)

	// Generate hash for the same prompt content
	promptHash := repo.GeneratePromptHash(prompt)

	// Try to find cached response
	cachedResponse, found, err := repo.GetPromptByHash(ctx, promptHash)

	assert.NoError(t, err)
	assert.True(t, found)
	assert.NotNil(t, cachedResponse)
	assert.Equal(t, "BUY", cachedResponse.Decision)
	assert.Equal(t, 0.85, cachedResponse.Confidence)
	assert.Equal(t, response.RawResponse, cachedResponse.RawResponse)
}

func TestPromptLogRepository_GetPromptByHash_NotFound(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// Try to find non-existent prompt hash
	fakeHash := "non-existent-hash-12345"
	cachedResponse, found, err := repo.GetPromptByHash(ctx, fakeHash)

	assert.NoError(t, err)
	assert.False(t, found)
	assert.Nil(t, cachedResponse)
}

func TestPromptLogRepository_GetPromptByHash_IgnoresFailed(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// Create prompt and log it with error (failed request)
	prompt := createTestAIPrompt()
	userID := "user-123"
	requestID := "req-456"
	intentID := "intent-789"

	logID, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
	require.NoError(t, err)

	testError := fmt.Errorf("API error")
	err = repo.UpdateWithError(ctx, logID, testError, 500, 1500)
	require.NoError(t, err)

	// Generate hash for the same prompt content
	promptHash := repo.GeneratePromptHash(prompt)

	// Should not find cached response since the request failed
	cachedResponse, found, err := repo.GetPromptByHash(ctx, promptHash)

	assert.NoError(t, err)
	assert.False(t, found)
	assert.Nil(t, cachedResponse)
}

func TestPromptLogRepository_GetFailedPrompts_Debugging(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// Create mix of successful and failed prompts
	testData := []struct {
		requestID string
		success   bool
		errorMsg  string
	}{
		{"req-1", true, ""},
		{"req-2", false, "API timeout"},
		{"req-3", false, "Rate limit exceeded"},
		{"req-4", true, ""},
		{"req-5", false, "Invalid request format"},
	}

	for i, data := range testData {
		prompt := createTestAIPrompt()
		userID := "user-123"
		intentID := fmt.Sprintf("intent-%d", i)

		logID, err := repo.LogPrompt(ctx, prompt, userID, data.requestID, intentID)
		require.NoError(t, err)

		if data.success {
			response := createTestAIResponse("BUY", 0.8)
			err = repo.UpdateWithResponse(ctx, logID, response, 2000)
			require.NoError(t, err)
		} else {
			testError := fmt.Errorf(data.errorMsg)
			err = repo.UpdateWithError(ctx, logID, testError, 500, 1500)
			require.NoError(t, err)
		}
	}

	// Get failed prompts from last 24 hours
	failedPromptsInterface, err := repo.GetFailedPrompts(ctx, 24)

	assert.NoError(t, err)
	
	// Type assert to get actual slice
	failedPrompts, ok := failedPromptsInterface.([]*models.AIPromptLogModel)
	require.True(t, ok, "Failed to type assert failed prompts")
	assert.Len(t, failedPrompts, 3) // Should have 3 failed prompts

	// Verify all returned prompts failed
	for _, prompt := range failedPrompts {
		assert.False(t, prompt.Success)
		assert.NotEmpty(t, prompt.ErrorMessage)
	}

	// Verify specific error messages
	errorMessages := make([]string, len(failedPrompts))
	for i, prompt := range failedPrompts {
		errorMessages[i] = prompt.ErrorMessage
	}
	assert.Contains(t, errorMessages, "API timeout")
	assert.Contains(t, errorMessages, "Rate limit exceeded")
	assert.Contains(t, errorMessages, "Invalid request format")
}

func TestPromptLogRepository_GetTokenUsage_TrackingAndCosts(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	// Create prompts with different token usage
	testData := []struct {
		requestID    string
		tokensInput  int
		tokensOutput int
		success      bool
	}{
		{"req-1", 100, 150, true},
		{"req-2", 200, 100, true},
		{"req-3", 150, 0, false}, // Failed request - no output tokens
		{"req-4", 300, 200, true},
	}

	for i, data := range testData {
		prompt := createTestAIPrompt()
		userID := "user-123"
		intentID := fmt.Sprintf("intent-%d", i)

		logID, err := repo.LogPrompt(ctx, prompt, userID, data.requestID, intentID)
		require.NoError(t, err)

		if data.success {
			response := createTestAIResponse("BUY", 0.8)
			response.TokensUsed = data.tokensOutput
			err = repo.UpdateWithResponse(ctx, logID, response, 2000)
			require.NoError(t, err)
		} else {
			testError := fmt.Errorf("API error")
			err = repo.UpdateWithError(ctx, logID, testError, 500, 1500)
			require.NoError(t, err)
		}
	}

	// Get token usage statistics
	usage, err := repo.GetTokenUsageStats(ctx, "user-123", 24)

	assert.NoError(t, err)
	assert.NotNil(t, usage)

	// Calculate expected values (only successful requests count for output)
	expectedInputTokens := int64(100 + 200 + 150 + 300)  // All requests
	expectedOutputTokens := int64(150 + 100 + 200)       // Only successful requests
	expectedTotalTokens := expectedInputTokens + expectedOutputTokens
	expectedSuccessfulRequests := int64(3)
	expectedFailedRequests := int64(1)

	assert.Equal(t, expectedInputTokens, usage.TotalInputTokens)
	assert.Equal(t, expectedOutputTokens, usage.TotalOutputTokens)
	assert.Equal(t, expectedTotalTokens, usage.TotalTokens)
	assert.Equal(t, expectedSuccessfulRequests, usage.SuccessfulRequests)
	assert.Equal(t, expectedFailedRequests, usage.FailedRequests)
	assert.Greater(t, usage.EstimatedTotalCost, 0.0)
}

func TestPromptLogRepository_GetRecentPrompts_TimeFilter(t *testing.T) {
	db := setupPromptLogTestDB(t)
	repo := NewPromptLogRepository(db)
	ctx := context.Background()

	now := time.Now()

	// Create prompts with different timestamps
	timestamps := []time.Time{
		now.Add(-30 * time.Hour), // 30 hours ago (outside 24-hour range)
		now.Add(-12 * time.Hour), // 12 hours ago (within 24-hour range)
		now.Add(-6 * time.Hour),  // 6 hours ago (within 24-hour range)
		now.Add(-2 * time.Hour),  // 2 hours ago (within 24-hour range)
	}

	for i, timestamp := range timestamps {
		prompt := createTestAIPrompt()
		userID := "user-123"
		requestID := fmt.Sprintf("req-%d", i)
		intentID := fmt.Sprintf("intent-%d", i)

		logID, err := repo.LogPrompt(ctx, prompt, userID, requestID, intentID)
		require.NoError(t, err)

		// Update the created timestamp manually for testing
		db.Model(&models.AIPromptLogModel{}).Where("id = ?", logID).Update("created_at", timestamp)

		// Add response
		response := createTestAIResponse("BUY", 0.8)
		err = repo.UpdateWithResponse(ctx, logID, response, 2000)
		require.NoError(t, err)
	}

	// Get prompts from last 24 hours
	recentPromptsInterface, err := repo.GetRecentPrompts(ctx, "user-123", 24)

	assert.NoError(t, err)
	
	// Type assert to get actual slice
	recentPrompts, ok := recentPromptsInterface.([]*models.AIPromptLogModel)
	require.True(t, ok, "Failed to type assert recent prompts")
	assert.Len(t, recentPrompts, 3) // Should exclude the 30-hour-old prompt

	// Verify all returned prompts are within the time range
	twentyFourHoursAgo := now.Add(-24 * time.Hour)
	for _, prompt := range recentPrompts {
		assert.True(t, prompt.CreatedAt.After(twentyFourHoursAgo),
			"Prompt timestamp %v should be after %v", prompt.CreatedAt, twentyFourHoursAgo)
	}
}

func TestPromptLogRepository_GeneratePromptHash_Consistency(t *testing.T) {
	repo := NewPromptLogRepository(nil) // No DB needed for hash generation

	prompt1 := createTestAIPrompt()
	prompt2 := createTestAIPrompt()
	
	// Modify prompt2 slightly
	prompt3 := createTestAIPrompt()
	prompt3.UserContext = "Different user context"

	hash1 := repo.GeneratePromptHash(prompt1)
	hash2 := repo.GeneratePromptHash(prompt2)
	hash3 := repo.GeneratePromptHash(prompt3)

	// Same prompts should produce same hash
	assert.Equal(t, hash1, hash2)
	
	// Different prompts should produce different hashes
	assert.NotEqual(t, hash1, hash3)
	
	// Hashes should be non-empty and consistent length
	assert.NotEmpty(t, hash1)
	assert.NotEmpty(t, hash3)
	assert.Equal(t, len(hash1), len(hash3))
}

