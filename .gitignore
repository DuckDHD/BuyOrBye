# ---------------------------------------
# OS / Editor
# ---------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------
# Env & secrets
# ---------------------------------------
.env
.env.*.local
*.key
*.pem

# ---------------------------------------
# Go
# ---------------------------------------
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with "go test -c"
*.test

# Coverage outputs
*.out
coverage.out
*.coverprofile

# Build artifacts & local binaries
main
/bin/
/tmp/
tmp/

# Go workspace file
go.work

# Generated by templ
*templ.go

# Optional: vendor dir (uncomment if you vendor deps)
# vendor/

# Common local DB files
*.db

# ---------------------------------------
# Node / Frontend
# ---------------------------------------
node_modules/
# Tailwind CLI binary & platform builds
tailwindcss
tailwindcss-*
tailwindcss-macos-arm64

# Built CSS (keep source in src/, ignore compiled outputs)
cmd/web/assets/css/output.css
cmd/web/static/css/output.css

# If you ever emit hashed bundles, ignore them here:
# cmd/web/static/js/*.bundle.*.js
# cmd/web/static/css/*.bundle.*.css

# ---------------------------------------
# Project-specific static outputs
# ---------------------------------------
# Keep icons, images, and manifest (they're source assets)
# Ignore any accidental build dumps under /static root if you generate there
# (comment these back out if you version static build artifacts)
# /static/css/
# /static/js/
# /static/*

# ---------------------------------------
# Misc
# ---------------------------------------
# Local build dir sometimes used by Go projects
/bin/app

# macOS tarball artifacts (if you ever create them)
*.tar.gz
*.zip
