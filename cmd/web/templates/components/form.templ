package components

import "github.com/DuckDHD/BuyOrBye/internal/types"

templ FormField(id, label, fieldType, placeholder, value string, required bool, errors []string) {
	<div class="space-y-1">
		<label for={ id } class="block text-sm font-medium text-gray-700 dark:text-gray-300">
			{ label }
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		switch fieldType {
			case "textarea":
				<textarea
					id={ id }
					name={ id }
					rows="4"
					placeholder={ placeholder }
					class={ "block w-full rounded-md border-0 py-1.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6 dark:bg-gray-700" + getFieldErrorClass(errors) }
					if required {
						required
					}
				>{ value }</textarea>
			case "select":
				<select
					id={ id }
					name={ id }
					class={ "block w-full rounded-md border-0 py-1.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6 dark:bg-gray-700" + getFieldErrorClass(errors) }
					if required {
						required
					}
				>
					{ children... }
				</select>
			default:
				<input
					type={ fieldType }
					id={ id }
					name={ id }
					value={ value }
					placeholder={ placeholder }
					class={ "block w-full rounded-md border-0 py-1.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6 dark:bg-gray-700" + getFieldErrorClass(errors) }
					if required {
						required
					}
				/>
		}
		if len(errors) > 0 {
			for _, error := range errors {
				<p class="text-sm text-red-600 dark:text-red-400">{ error }</p>
			}
		}
	</div>
}

templ Button(text, buttonType, variant string, disabled bool, attrs templ.Attributes) {
	<button
		type={ buttonType }
		class={ getButtonClass(variant, disabled) }
		if disabled {
			disabled
		}
		{ attrs... }
	>
		{ text }
	</button>
}

templ ButtonWithIcon(text, buttonType, variant string, disabled bool, iconSVG templ.Component, attrs templ.Attributes) {
	<button
		type={ buttonType }
		class={ getButtonClass(variant, disabled) + " flex items-center justify-center space-x-2" }
		if disabled {
			disabled
		}
		{ attrs... }
	>
		@iconSVG
		<span>{ text }</span>
	</button>
}

templ Card(title string) {
	<div class="bg-white dark:bg-gray-800 shadow rounded-lg">
		if title != "" {
			<div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
				<h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white">{ title }</h3>
			</div>
		}
		<div class="px-4 py-5 sm:p-6">
			{ children... }
		</div>
	</div>
}

templ LoadingSpinner(size string) {
	<svg class={ "animate-spin " + getSpinnerSize(size) } xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
	</svg>
}

func getFieldErrorClass(errors []string) string {
	if len(errors) > 0 {
		return " ring-red-300 dark:ring-red-600 focus:ring-red-600"
	}
	return ""
}

func getButtonClass(variant string, disabled bool) string {
	base := "inline-flex justify-center rounded-md px-3 py-2 text-sm font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-colors"
	
	if disabled {
		return base + " bg-gray-300 text-gray-500 cursor-not-allowed"
	}
	
	switch variant {
	case "primary":
		return base + " bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600"
	case "secondary":
		return base + " bg-white text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-gray-700 dark:text-white dark:ring-gray-600 dark:hover:bg-gray-600"
	case "danger":
		return base + " bg-red-600 text-white hover:bg-red-500 focus-visible:outline-red-600"
	case "success":
		return base + " bg-green-600 text-white hover:bg-green-500 focus-visible:outline-green-600"
	default:
		return base + " bg-gray-600 text-white hover:bg-gray-500 focus-visible:outline-gray-600"
	}
}

func getSpinnerSize(size string) string {
	switch size {
	case "sm":
		return "h-4 w-4"
	case "md":
		return "h-6 w-6"
	case "lg":
		return "h-8 w-8"
	case "xl":
		return "h-12 w-12"
	default:
		return "h-5 w-5"
	}
}