package components

templ EmptyState(title, description, actionText, actionHref, iconType string) {
	<div class="text-center py-12">
		<div class="mx-auto h-24 w-24 text-gray-400 dark:text-gray-500 mb-6">
			@EmptyStateIcon(iconType)
		</div>
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
			{ title }
		</h3>
		<p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto mb-6">
			{ description }
		</p>
		if actionText != "" && actionHref != "" {
			<div>
				<a 
					href={ templ.URL(actionHref) }
					class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					hx-boost="true"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
					{ actionText }
				</a>
			</div>
		}
	</div>
}

templ EmptyDecisions() {
	@EmptyState("No decisions yet", "Start making smarter purchase decisions with AI-powered insights. Create your first decision to get started!", "New Decision", "/decisions/new", "decision")
}

templ EmptyPurchases() {
	@EmptyState("No purchases tracked", "Keep track of your purchases and spending patterns. Add your first purchase to start building insights.", "Add Purchase", "/purchases/new", "purchase")
}

templ EmptyFinance() {
	@EmptyState("No financial data", "Add your income and expenses to get personalized financial insights and recommendations.", "Add Income", "/finance/add", "finance")
}

templ EmptyHealth() {
	@EmptyState("No health data", "Track your health metrics and get AI-powered recommendations for better wellness decisions.", "Add Health Data", "/health/add", "health")
}

templ EmptySearchResults(query string) {
	<div class="text-center py-12">
		<div class="mx-auto h-24 w-24 text-gray-400 dark:text-gray-500 mb-6">
			@EmptyStateIcon("search")
		</div>
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
			No results found
		</h3>
		<p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto mb-6">
			We couldn't find anything matching "{ query }". Try adjusting your search terms or filters.
		</p>
		<div class="flex flex-col sm:flex-row gap-3 justify-center">
			<button 
				type="button"
				class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 shadow-sm text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				onclick="document.querySelector('input[type=search]')?.focus()"
			>
				<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
				Try another search
			</button>
			<button 
				type="button"
				class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 dark:hover:bg-blue-900/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				onclick="window.history.back()"
			>
				<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
				</svg>
				Go back
			</button>
		</div>
	</div>
}

templ EmptyFiltered() {
	<div class="text-center py-12">
		<div class="mx-auto h-24 w-24 text-gray-400 dark:text-gray-500 mb-6">
			@EmptyStateIcon("filter")
		</div>
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
			No items match your filters
		</h3>
		<p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto mb-6">
			Try adjusting your filters or clearing them to see more results.
		</p>
		<div>
			<button 
				type="button"
				class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 dark:hover:bg-blue-900/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				onclick="document.querySelectorAll('input[type=checkbox]:checked').forEach(cb => cb.checked = false); document.querySelector('form')?.submit();"
			>
				<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
				Clear all filters
			</button>
		</div>
	</div>
}

templ EmptyError() {
	<div class="text-center py-12">
		<div class="mx-auto h-24 w-24 text-red-400 dark:text-red-500 mb-6">
			@EmptyStateIcon("error")
		</div>
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
			Something went wrong
		</h3>
		<p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto mb-6">
			We encountered an error while loading your data. Please try refreshing the page.
		</p>
		<div class="flex flex-col sm:flex-row gap-3 justify-center">
			<button 
				type="button"
				class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				onclick="window.location.reload()"
			>
				<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
				Try again
			</button>
			<a 
				href="/dashboard"
				class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 shadow-sm text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				hx-boost="true"
			>
				<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
				</svg>
				Go home
			</a>
		</div>
	</div>
}

templ EmptyStateIcon(iconType string) {
	switch iconType {
		case "decision":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"></path>
			</svg>
		case "purchase":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path>
			</svg>
		case "finance":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "health":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"></path>
			</svg>
		case "search":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
		case "filter":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
			</svg>
		case "error":
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12V15.75z"></path>
			</svg>
		default:
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
			</svg>
	}
}