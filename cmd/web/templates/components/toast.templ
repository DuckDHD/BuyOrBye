package components

templ ToastContainer() {
	<div 
		id="toast-container" 
		class="fixed top-4 right-4 z-50 space-y-3 max-w-sm"
		x-data="{ toasts: Alpine.store('toast').toasts }"
		x-show="toasts.length > 0"
	>
		<template x-for="toast in toasts" :key="toast.id">
			<div 
				class="transform transition-all duration-300 ease-out"
				x-show="true"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-x-full"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 translate-x-full"
			>
				@Toast("", "", "")
			</div>
		</template>
	</div>
}

templ Toast(message, type_attr, id string) {
	<div 
		class={ "max-w-sm w-full shadow-lg rounded-lg pointer-events-auto overflow-hidden border " + getToastClasses(type_attr) }
		x-data="{ show: true }"
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-2"
		role="alert"
		aria-live="assertive"
		aria-atomic="true"
	>
		<div class="p-4">
			<div class="flex items-start">
				<div class="flex-shrink-0">
					@ToastIcon(type_attr)
				</div>
				<div class="ml-3 w-0 flex-1">
					<p class={ "text-sm font-medium " + getToastTextColor(type_attr) } x-text="toast ? toast.message : '{ message }'">
						if message != "" {
							{ message }
						}
					</p>
				</div>
				<div class="ml-4 flex-shrink-0 flex">
					<button 
						class={ "rounded-md inline-flex focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors " + getToastButtonClasses(type_attr) }
						@click="Alpine.store('toast').remove(toast ? toast.id : 0); show = false"
						aria-label="Close notification"
					>
						<span class="sr-only">Close</span>
						<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
						</svg>
					</button>
				</div>
			</div>
		</div>
		<!-- Progress bar for auto-dismiss -->
		<div class={ "h-1 " + getToastProgressClasses(type_attr) }>
			<div 
				class={ "h-full transition-all ease-linear " + getToastProgressBarClasses(type_attr) }
				x-data="{ width: 100 }"
				:style="`width: ${width}%`"
				x-init="
					let duration = toast ? toast.duration : 5000;
					let interval = 50;
					let steps = duration / interval;
					let step = 0;
					let timer = setInterval(() => {
						step++;
						width = 100 - (step / steps) * 100;
						if (step >= steps) {
							clearInterval(timer);
							Alpine.store('toast').remove(toast ? toast.id : 0);
							show = false;
						}
					}, interval);
				"
			></div>
		</div>
	</div>
}

templ ToastWithAction(message, type_attr, id, actionText, actionHref string) {
	<div 
		class={ "max-w-sm w-full shadow-lg rounded-lg pointer-events-auto overflow-hidden border " + getToastClasses(type_attr) }
		x-data="{ show: true }"
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-2"
		role="alert"
		aria-live="assertive"
		aria-atomic="true"
	>
		<div class="p-4">
			<div class="flex items-start">
				<div class="flex-shrink-0">
					@ToastIcon(type_attr)
				</div>
				<div class="ml-3 w-0 flex-1">
					<p class={ "text-sm font-medium mb-2 " + getToastTextColor(type_attr) }>
						{ message }
					</p>
					if actionText != "" && actionHref != "" {
						<div class="mt-3">
							<a 
								href={ templ.URL(actionHref) }
								class={ "text-sm font-medium underline hover:no-underline transition-all " + getToastLinkColor(type_attr) }
								hx-boost="true"
								@click="show = false"
							>
								{ actionText }
							</a>
						</div>
					}
				</div>
				<div class="ml-4 flex-shrink-0 flex">
					<button 
						class={ "rounded-md inline-flex focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors " + getToastButtonClasses(type_attr) }
						@click="show = false"
						aria-label="Close notification"
					>
						<span class="sr-only">Close</span>
						<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
						</svg>
					</button>
				</div>
			</div>
		</div>
		<!-- Progress bar -->
		<div class={ "h-1 " + getToastProgressClasses(type_attr) }>
			<div 
				class={ "h-full transition-all ease-linear " + getToastProgressBarClasses(type_attr) }
				x-data="{ width: 100 }"
				:style="`width: ${width}%`"
				x-init="
					setTimeout(() => {
						let duration = 8000;
						let interval = 80;
						let steps = duration / interval;
						let step = 0;
						let timer = setInterval(() => {
							step++;
							width = 100 - (step / steps) * 100;
							if (step >= steps) {
								clearInterval(timer);
								show = false;
							}
						}, interval);
					}, 1000);
				"
			></div>
		</div>
	</div>
}

templ ToastIcon(type_attr string) {
	switch type_attr {
		case "success":
			<div class="flex-shrink-0">
				<svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</div>
		case "error":
			<div class="flex-shrink-0">
				<svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</div>
		case "warning":
			<div class="flex-shrink-0">
				<svg class="h-6 w-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
				</svg>
			</div>
		case "info":
			<div class="flex-shrink-0">
				<svg class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</div>
		case "loading":
			<div class="flex-shrink-0">
				<svg class="animate-spin h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			</div>
		default:
			<div class="flex-shrink-0">
				<svg class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</div>
	}
}

// Specialized toast variants
templ SuccessToast(message string) {
	@Toast(message, "success", "")
}

templ ErrorToast(message string) {
	@Toast(message, "error", "")
}

templ WarningToast(message string) {
	@Toast(message, "warning", "")
}

templ InfoToast(message string) {
	@Toast(message, "info", "")
}

templ LoadingToast(message string) {
	@Toast(message, "loading", "")
}

// Utility functions
func getToastClasses(type_attr string) string {
	switch type_attr {
	case "success":
		return "bg-white dark:bg-gray-800 border-green-200 dark:border-green-800"
	case "error":
		return "bg-white dark:bg-gray-800 border-red-200 dark:border-red-800"
	case "warning":
		return "bg-white dark:bg-gray-800 border-yellow-200 dark:border-yellow-800"
	case "info":
		return "bg-white dark:bg-gray-800 border-blue-200 dark:border-blue-800"
	case "loading":
		return "bg-white dark:bg-gray-800 border-blue-200 dark:border-blue-800"
	default:
		return "bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700"
	}
}

func getToastTextColor(type_attr string) string {
	switch type_attr {
	case "success":
		return "text-gray-900 dark:text-white"
	case "error":
		return "text-gray-900 dark:text-white"
	case "warning":
		return "text-gray-900 dark:text-white"
	case "info":
		return "text-gray-900 dark:text-white"
	case "loading":
		return "text-gray-900 dark:text-white"
	default:
		return "text-gray-900 dark:text-white"
	}
}

func getToastLinkColor(type_attr string) string {
	switch type_attr {
	case "success":
		return "text-green-600 dark:text-green-400"
	case "error":
		return "text-red-600 dark:text-red-400"
	case "warning":
		return "text-yellow-600 dark:text-yellow-400"
	case "info":
		return "text-blue-600 dark:text-blue-400"
	case "loading":
		return "text-blue-600 dark:text-blue-400"
	default:
		return "text-gray-600 dark:text-gray-400"
	}
}

func getToastButtonClasses(type_attr string) string {
	switch type_attr {
	case "success":
		return "text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 focus:ring-green-500"
	case "error":
		return "text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 focus:ring-red-500"
	case "warning":
		return "text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 focus:ring-yellow-500"
	case "info":
		return "text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 focus:ring-blue-500"
	case "loading":
		return "text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 focus:ring-blue-500"
	default:
		return "text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 focus:ring-gray-500"
	}
}

func getToastProgressClasses(type_attr string) string {
	switch type_attr {
	case "success":
		return "bg-green-100 dark:bg-green-900/20"
	case "error":
		return "bg-red-100 dark:bg-red-900/20"
	case "warning":
		return "bg-yellow-100 dark:bg-yellow-900/20"
	case "info":
		return "bg-blue-100 dark:bg-blue-900/20"
	case "loading":
		return "bg-blue-100 dark:bg-blue-900/20"
	default:
		return "bg-gray-100 dark:bg-gray-700"
	}
}

func getToastProgressBarClasses(type_attr string) string {
	switch type_attr {
	case "success":
		return "bg-green-500 dark:bg-green-400"
	case "error":
		return "bg-red-500 dark:bg-red-400"
	case "warning":
		return "bg-yellow-500 dark:bg-yellow-400"
	case "info":
		return "bg-blue-500 dark:bg-blue-400"
	case "loading":
		return "bg-blue-500 dark:bg-blue-400"
	default:
		return "bg-gray-500 dark:bg-gray-400"
	}
}