package layouts

import "github.com/DuckDHD/BuyOrBye/internal/types"

templ App(title string, csrfToken string, user *types.UserResponseDTO, currentPath string) {
	@Base(title, csrfToken) {
		<div class="min-h-full" x-data="{ sidebarOpen: false }">
			<!-- Mobile menu overlay -->
			<div x-show="sidebarOpen" class="relative z-50 lg:hidden" x-transition:enter="transition-opacity ease-linear duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition-opacity ease-linear duration-300" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
				<div class="fixed inset-0 bg-gray-900/80" @click="sidebarOpen = false"></div>

				<div class="fixed inset-0 flex">
					<div x-show="sidebarOpen" class="relative mr-16 flex w-full max-w-xs flex-1" x-transition:enter="transition ease-in-out duration-300 transform" x-transition:enter-start="-translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition ease-in-out duration-300 transform" x-transition:leave-start="translate-x-0" x-transition:leave-end="-translate-x-full">
						<div class="absolute left-full top-0 flex w-16 justify-center pt-5">
							<button type="button" class="-m-2.5 p-2.5" @click="sidebarOpen = false">
								<span class="sr-only">Close sidebar</span>
								<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
								</svg>
							</button>
						</div>

						@Sidebar(user, currentPath, true)
					</div>
				</div>
			</div>

			<!-- Desktop sidebar -->
			<div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
				@Sidebar(user, currentPath, false)
			</div>

			<div class="lg:pl-72">
				<!-- Top navigation -->
				@TopNavigation(user, currentPath)

				<!-- Main content -->
				<main class="py-6">
					<div class="px-4 sm:px-6 lg:px-8">
						{ children... }
					</div>
				</main>
			</div>
		</div>
	}
}

templ Sidebar(user *types.UserResponseDTO, currentPath string, isMobile bool) {
	<div class="flex grow flex-col gap-y-5 overflow-y-auto bg-white dark:bg-gray-900 px-6 pb-4 border-r border-gray-200 dark:border-gray-700">
		<div class="flex h-16 shrink-0 items-center">
			<a href="/dashboard" class="flex items-center space-x-2">
				<div class="w-8 h-8 bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg flex items-center justify-center">
					<span class="text-white font-bold">B</span>
				</div>
				<span class="text-xl font-bold text-gray-900 dark:text-white">BuyOrBye</span>
			</a>
		</div>
		<nav class="flex flex-1 flex-col">
			<ul role="list" class="flex flex-1 flex-col gap-y-7">
				<li>
					<ul role="list" class="-mx-2 space-y-1">
						@NavItem("/dashboard", "Dashboard", "M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25", currentPath)
						@NavItem("/decisions", "Decisions", "M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z", currentPath)
						@NavItem("/finance", "Finance", "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z", currentPath)
						@NavItem("/health", "Health", "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z", currentPath)
						@NavItem("/profile", "Profile", "M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z", currentPath)
					</ul>
				</li>
				<li class="mt-auto">
					<div class="flex items-center space-x-3 px-2 py-3 text-sm font-medium text-gray-700 dark:text-gray-300">
						<div class="w-8 h-8 bg-gray-300 dark:bg-gray-600 rounded-full flex items-center justify-center">
							<span class="text-gray-600 dark:text-gray-300 font-medium">{ user.Name[:1] }</span>
						</div>
						<div class="flex-1">
							<p class="text-sm font-medium text-gray-900 dark:text-white">{ user.Name }</p>
							<p class="text-xs text-gray-500 dark:text-gray-400">{ user.Email }</p>
						</div>
					</div>
				</li>
			</ul>
		</nav>
	</div>
}

templ TopNavigation(user *types.UserResponseDTO, currentPath string) {
	<div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 shadow-sm sm:gap-x-6 sm:px-6 lg:px-8">
		<button type="button" class="-m-2.5 p-2.5 text-gray-700 dark:text-gray-300 lg:hidden" @click="sidebarOpen = true">
			<span class="sr-only">Open sidebar</span>
			<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
			</svg>
		</button>

		<!-- Separator -->
		<div class="h-6 w-px bg-gray-200 dark:bg-gray-700 lg:hidden"></div>

		<div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6">
			<div class="relative flex flex-1"></div>
			<div class="flex items-center gap-x-4 lg:gap-x-6">
				<!-- Dark mode toggle -->
				<button 
					onclick="toggleDarkMode()" 
					class="-m-2.5 p-2.5 text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400"
					aria-label="Toggle dark mode"
				>
					<svg class="h-6 w-6 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
					</svg>
					<svg class="h-6 w-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"></path>
					</svg>
				</button>

				<!-- Separator -->
				<div class="hidden lg:block lg:h-6 lg:w-px lg:bg-gray-200 dark:lg:bg-gray-700"></div>

				<!-- Profile dropdown -->
				<div class="relative" x-data="{ dropdownOpen: false }">
					<button 
						type="button" 
						class="-m-1.5 flex items-center p-1.5" 
						@click="dropdownOpen = !dropdownOpen"
						@click.away="dropdownOpen = false"
					>
						<span class="sr-only">Open user menu</span>
						<div class="w-8 h-8 bg-gray-300 dark:bg-gray-600 rounded-full flex items-center justify-center">
							<span class="text-gray-600 dark:text-gray-300 font-medium text-sm">{ user.Name[:1] }</span>
						</div>
						<span class="hidden lg:flex lg:items-center">
							<span class="ml-4 text-sm font-semibold leading-6 text-gray-900 dark:text-white">{ user.Name }</span>
							<svg class="ml-2 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
							</svg>
						</span>
					</button>

					<div 
						x-show="dropdownOpen" 
						x-transition:enter="transition ease-out duration-200" 
						x-transition:enter-start="transform opacity-0 scale-95" 
						x-transition:enter-end="transform opacity-100 scale-100" 
						x-transition:leave="transition ease-in duration-75" 
						x-transition:leave-start="transform opacity-100 scale-100" 
						x-transition:leave-end="transform opacity-0 scale-95"
						class="absolute right-0 z-10 mt-2.5 w-32 origin-top-right rounded-md bg-white dark:bg-gray-800 py-2 shadow-lg ring-1 ring-gray-900/5 dark:ring-gray-700 focus:outline-none"
					>
						<a href="/profile" class="block px-3 py-1 text-sm leading-6 text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700">Profile</a>
						<a href="/settings" class="block px-3 py-1 text-sm leading-6 text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700">Settings</a>
						<form method="POST" action="/auth/logout" class="m-0">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button type="submit" class="block w-full text-left px-3 py-1 text-sm leading-6 text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700">Sign out</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ NavItem(href, label, iconPath, currentPath string) {
	<li>
		if currentPath == href {
			<a 
				href={ templ.URL(href) } 
				class="bg-gray-50 dark:bg-gray-800 text-blue-600 dark:text-blue-400 group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold"
			>
				<svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d={ iconPath }></path>
				</svg>
				{ label }
			</a>
		} else {
			<a 
				href={ templ.URL(href) } 
				class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-50 dark:hover:bg-gray-800 group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold"
			>
				<svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d={ iconPath }></path>
				</svg>
				{ label }
			</a>
		}
	</li>
}