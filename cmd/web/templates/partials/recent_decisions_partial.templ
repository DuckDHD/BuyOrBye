package partials

import (
	"github.com/DuckDHD/BuyOrBye/cmd/web/templates/components"
	"fmt"
	"strings"
)

templ RecentDecisions(decisions []RecentDecisionDTO, hasMore bool) {
	<div id="recent-decisions" class="space-y-4">
		if len(decisions) > 0 {
			<div class="space-y-3">
				for _, decision := range decisions {
					@RecentDecisionCard(decision)
				}
			</div>
			
			if hasMore {
				<div class="text-center pt-4">
					<button 
						type="button"
						class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 shadow-sm text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
						hx-get="/ui/partials/decisions/recent"
						hx-target="#recent-decisions .space-y-3"
						hx-swap="beforeend"
						hx-vals='{"offset": "{ len(decisions) }"}'
						hx-indicator="#load-more-spinner"
					>
						<span id="load-more-spinner" class="htmx-indicator">
							<svg class="animate-spin -ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</span>
						<span class="htmx-indicator-hide">Load More</span>
					</button>
				</div>
			} else {
				<div class="text-center pt-4 border-t border-gray-200 dark:border-gray-700">
					<a 
						href="/decisions" 
						class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
						hx-boost="true"
					>
						View all decisions
						<svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</a>
				</div>
			}
		} else {
			@components.EmptyDecisions()
		}
	</div>
}

templ RecentDecisionCard(decision RecentDecisionDTO) {
	<div class={ "bg-white dark:bg-gray-800 rounded-lg shadow-sm border-l-4 p-4 hover:shadow-md transition-shadow cursor-pointer " + getRecentDecisionBorderColor(decision.Decision) }>
		<div class="flex items-start justify-between">
			<div class="flex-1 min-w-0">
				<div class="flex items-center space-x-3">
					<div class={ "w-3 h-3 rounded-full flex-shrink-0 " + getDecisionDotColor(decision.Decision) }></div>
					<h4 class="text-sm font-medium text-gray-900 dark:text-white truncate">
						{ decision.ItemName }
					</h4>
				</div>
				
				<div class="mt-2 flex items-center space-x-4 text-xs text-gray-500 dark:text-gray-400">
					<div class="flex items-center">
						<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
						</svg>
						${ fmt.Sprintf("%.2f", decision.Cost) }
					</div>
					
					if decision.Category != "" {
						<div class="flex items-center">
							<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
							</svg>
							{ decision.Category }
						</div>
					}
					
					<div class="flex items-center">
						<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						{ decision.TimeAgo }
					</div>
				</div>

				if decision.Reasoning != "" {
					<p class="mt-2 text-xs text-gray-600 dark:text-gray-300 line-clamp-2">
						{ decision.Reasoning }
					</p>
				}
			</div>

			<div class="flex-shrink-0 ml-4">
				<div class="flex flex-col items-end space-y-2">
					<span class={ "inline-flex items-center px-2 py-1 rounded-full text-xs font-medium " + getRecentDecisionBadgeClass(decision.Decision) }>
						{ decision.Decision }
					</span>
					
					if decision.Confidence != "" {
						<div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
							<div class="flex items-center">
								<span class="mr-1">{ decision.Confidence }%</span>
								<div class="w-8 h-1 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
									<div 
										class={ "h-full transition-all duration-500 " + getRecentConfidenceBarColor(decision.Confidence) }
										style={ "width: " + decision.Confidence + "%" }
									></div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Expandable Actions (Hidden by default) -->
		<div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700 hidden group-hover:block">
			<div class="flex items-center justify-between">
				<div class="flex space-x-2">
					<a
						href={ "/decisions/" + decision.ID }
						target="_blank"
						class="inline-flex items-center px-2 py-1 text-xs font-medium text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
					>
						<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
						View Details
					</a>
					
					if decision.CanEdit {
						<button 
							type="button"
							class="inline-flex items-center px-2 py-1 text-xs font-medium text-gray-600 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 transition-colors"
							hx-get={ "/decisions/" + decision.ID + "/edit" }
							hx-target="#edit-modal"
							hx-swap="innerHTML"
						>
							<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
							</svg>
							Edit
						</button>
					}
				</div>
				
				<div class="text-xs text-gray-400 dark:text-gray-500">
					ID: { decision.ID }
				</div>
			</div>
		</div>
	</div>
}

templ DecisionSkeleton() {
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border-l-4 border-gray-200 dark:border-gray-600 p-4 animate-pulse">
		<div class="flex items-start justify-between">
			<div class="flex-1">
				<div class="flex items-center space-x-3">
					<div class="w-3 h-3 bg-gray-300 dark:bg-gray-600 rounded-full"></div>
					<div class="h-4 bg-gray-300 dark:bg-gray-600 rounded w-32"></div>
				</div>
				<div class="mt-2 flex items-center space-x-4">
					<div class="h-3 bg-gray-300 dark:bg-gray-600 rounded w-16"></div>
					<div class="h-3 bg-gray-300 dark:bg-gray-600 rounded w-20"></div>
					<div class="h-3 bg-gray-300 dark:bg-gray-600 rounded w-24"></div>
				</div>
				<div class="mt-2 h-3 bg-gray-300 dark:bg-gray-600 rounded w-full"></div>
				<div class="mt-1 h-3 bg-gray-300 dark:bg-gray-600 rounded w-3/4"></div>
			</div>
			<div class="flex-shrink-0 ml-4">
				<div class="h-6 bg-gray-300 dark:bg-gray-600 rounded-full w-16 mb-2"></div>
				<div class="h-2 bg-gray-300 dark:bg-gray-600 rounded w-12"></div>
			</div>
		</div>
	</div>
}

type RecentDecisionDTO struct {
	ID         string
	ItemName   string
	Decision   string
	Cost       float64
	Category   string
	Confidence string
	Reasoning  string
	TimeAgo    string
	CanEdit    bool
}

func getRecentDecisionBorderColor(decision string) string {
	switch decision {
	case "BUY":
		return "border-green-500 dark:border-green-400"
	case "WAIT":
		return "border-yellow-500 dark:border-yellow-400"
	case "BYE":
		return "border-red-500 dark:border-red-400"
	default:
		return "border-gray-300 dark:border-gray-600"
	}
}

func getDecisionDotColor(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-500"
	case "WAIT":
		return "bg-yellow-500"
	case "BYE":
		return "bg-red-500"
	default:
		return "bg-gray-400"
	}
}

func getRecentDecisionBadgeClass(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "WAIT":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	case "BYE":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300"
	}
}

func getRecentConfidenceBarColor(confidence string) string {
	// Parse confidence to determine color
	if confidence == "" {
		return "bg-gray-400"
	}
	
	// Simple heuristic based on confidence level
	if strings.HasSuffix(confidence, "%") {
		confStr := strings.TrimSuffix(confidence, "%")
		if len(confStr) >= 2 { // Assume 80%+
			return "bg-green-500"
		} else if len(confStr) >= 1 { // Assume 50-79%
			return "bg-yellow-500"
		} else { // Lower confidence
			return "bg-red-500"
		}
	}
	
	return "bg-gray-400"
}