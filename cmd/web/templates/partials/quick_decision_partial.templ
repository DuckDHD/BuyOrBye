package partials

import "fmt"

templ QuickDecisionForm(csrfToken string) {
	<div id="quick-decision-form" x-data="quickDecisionData()">
		<form 
			hx-post="/decision/evaluate"
			hx-target="#decision-result"
			hx-swap="innerHTML"
			hx-indicator="#decision-loading"
			@submit="isLoading = true"
		>
			<input type="hidden" name="csrf_token" value="{{ .csrf_token }}">

			
			<div class="space-y-4">
				<!-- Item Name -->
				<div>
					<label for="item-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
						What are you considering?
					</label>
					<input 
						id="item-name" 
						name="item_name" 
						type="text" 
						required 
						class="block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 placeholder-gray-500 dark:placeholder-gray-400 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
						placeholder="e.g., iPhone 15 Pro, Coffee Machine, Gym Membership"
						x-model="form.itemName"
					/>
				</div>

				<!-- Cost -->
				<div>
					<label for="cost" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
						Cost
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<span class="text-gray-500 dark:text-gray-400 sm:text-sm">$</span>
						</div>
						<input 
							id="cost" 
							name="cost" 
							type="number" 
							step="0.01" 
							min="0"
							required 
							class="block w-full rounded-md border border-gray-300 dark:border-gray-600 pl-8 pr-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 placeholder-gray-500 dark:placeholder-gray-400 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
							placeholder="0.00"
							x-model="form.cost"
						/>
					</div>
				</div>

				<!-- Urgency Level -->
				<div>
					<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						How urgent is this purchase?
					</label>
					<div class="space-y-2">
						<div class="flex items-center">
							<input 
								id="urgency-low" 
								name="urgency" 
								type="radio" 
								value="low"
								class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600"
								x-model="form.urgency"
							/>
							<label for="urgency-low" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
								<span class="font-medium">Low</span> - I can wait months or longer
							</label>
						</div>
						<div class="flex items-center">
							<input 
								id="urgency-medium" 
								name="urgency" 
								type="radio" 
								value="medium"
								class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600"
								x-model="form.urgency"
							/>
							<label for="urgency-medium" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
								<span class="font-medium">Medium</span> - I need it within weeks
							</label>
						</div>
						<div class="flex items-center">
							<input 
								id="urgency-high" 
								name="urgency" 
								type="radio" 
								value="high"
								class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600"
								x-model="form.urgency"
							/>
							<label for="urgency-high" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
								<span class="font-medium">High</span> - I need it now or very soon
							</label>
						</div>
					</div>
				</div>

				<!-- Additional Context (Optional) -->
				<div>
					<label for="context" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
						Additional context (optional)
					</label>
					<textarea 
						id="context" 
						name="context" 
						rows="2"
						class="block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 placeholder-gray-500 dark:placeholder-gray-400 focus:border-blue-500 focus:ring-blue-500 sm:text-sm resize-none"
						placeholder="Any special circumstances, alternatives you've considered, etc."
						x-model="form.context"
					></textarea>
				</div>

				<!-- Submit Button -->
				<div class="pt-2">
					<button 
						type="submit" 
						class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
						:disabled="!canSubmit"
					>
						<span id="decision-loading" class="htmx-indicator">
							<svg class="animate-spin -ml-1 mr-3 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
							Analyzing...
						</span>
						<span class="htmx-indicator-hide">Get AI Recommendation</span>
					</button>
				</div>
			</div>
		</form>

		<!-- Result Area -->
		<div id="decision-result" class="mt-6"></div>
	</div>

	<script>
		function quickDecisionData() {
			return {
				form: {
					itemName: '',
					cost: '',
					urgency: '',
					context: ''
				},
				isLoading: false,
				
				get canSubmit() {
					return this.form.itemName.trim() !== '' && 
						   this.form.cost !== '' && 
						   parseFloat(this.form.cost) >= 0 && 
						   this.form.urgency !== '' &&
						   !this.isLoading;
				},
				
				clearForm() {
					this.form = {
						itemName: '',
						cost: '',
						urgency: '',
						context: ''
					};
					this.isLoading = false;
					document.getElementById('decision-result').innerHTML = '';
				}
			}
		}
	</script>
}

templ QuickDecisionResult(decision *QuickDecisionResultDTO) {
	<div 
		class={ "rounded-lg border-l-4 p-6 transition-all duration-500 " + getQuickDecisionClasses(decision.Decision) }
		x-data="{ showDetails: false }"
		x-show="true"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 transform scale-95"
		x-transition:enter-end="opacity-100 transform scale-100"
	>
		<!-- Main Result -->
		<div class="flex items-start justify-between">
			<div class="flex-1">
				<div class="flex items-center">
					<div class={ "w-4 h-4 rounded-full mr-3 " + getQuickDecisionDotColor(decision.Decision) }></div>
					<h3 class={ "text-lg font-semibold " + getQuickDecisionTextColor(decision.Decision) }>
						{ decision.Decision }: { decision.ItemName }
					</h3>
				</div>
				
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
					{ decision.Summary }
				</p>

				<!-- Confidence Score -->
				<div class="mt-4 flex items-center">
					<span class="text-sm text-gray-600 dark:text-gray-400 mr-3">Confidence:</span>
					<div class="flex items-center">
						<div class="w-24 bg-gray-200 dark:bg-gray-700 rounded-full h-2 mr-2">
							<div 
								class={ "h-2 rounded-full transition-all duration-1000 " + getQuickConfidenceBarColor(decision.Confidence) }
								x-data="{ width: 0 }"
								x-init="setTimeout(() => width = { decision.Confidence }, 100)"
								:style="`width: ${width}%`"
							></div>
						</div>
						<span class="text-sm font-medium text-gray-900 dark:text-white">
							{ fmt.Sprintf("%d", decision.Confidence) }%
						</span>
					</div>
				</div>
			</div>

			<!-- Decision Badge -->
			<div class="ml-4 flex-shrink-0">
				<span class={ "inline-flex items-center px-3 py-1 rounded-full text-sm font-medium " + getQuickDecisionBadgeClass(decision.Decision) }>
					{ decision.Decision }
				</span>
			</div>
		</div>

		<!-- Key Points -->
		if len(decision.KeyPoints) > 0 {
			<div class="mt-4">
				<button 
					type="button"
					class="flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors"
					@click="showDetails = !showDetails"
				>
					<svg 
						class="w-4 h-4 mr-1 transition-transform duration-200"
						:class="{ 'rotate-90': showDetails }"
						fill="none" 
						stroke="currentColor" 
						viewBox="0 0 24 24"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
					<span x-text="showDetails ? 'Hide Details' : 'Show Key Points'">Show Key Points</span>
				</button>
				
				<div 
					x-show="showDetails"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 max-h-0"
					x-transition:enter-end="opacity-100 max-h-screen"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100 max-h-screen"
					x-transition:leave-end="opacity-0 max-h-0"
					class="mt-3 overflow-hidden"
				>
					<ul class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
						for _, point := range decision.KeyPoints {
							<li class="flex items-start">
								<svg class="w-4 h-4 mt-0.5 mr-2 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
								{ point }
							</li>
						}
					</ul>
				</div>
			</div>
		}

		<!-- Actions -->
		<div class="mt-6 flex items-center justify-between pt-4 border-t border-gray-200 dark:border-gray-700">
			<div class="flex space-x-2">
				<button 
					type="button"
					class="inline-flex items-center px-3 py-1.5 border border-gray-300 dark:border-gray-600 text-xs font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					hx-post="/decision/save"
					hx-vals={ `{"decision_id": "` + decision.ID + `"}` }
					hx-target="this"
					hx-swap="outerHTML"
				>
					<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
					</svg>
					Save Decision
				</button>
				
				<button 
					type="button"
					class="inline-flex items-center px-3 py-1.5 border border-gray-300 dark:border-gray-600 text-xs font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					onclick="navigator.share && navigator.share({title: 'BuyOrBye Decision', text: '{ decision.Summary }', url: window.location.href})"
				>
					<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
					</svg>
					Share
				</button>
			</div>

			<button 
				type="button"
				class="text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
				onclick="Alpine.data('quickDecisionData')().clearForm()"
			>
				New Decision
			</button>
		</div>

		if decision.ProcessingTimeMs > 0 {
			<div class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-right">
				Analyzed in { fmt.Sprintf("%dms", decision.ProcessingTimeMs) }
			</div>
		}
	</div>
}

type QuickDecisionResultDTO struct {
	ID               string
	ItemName         string
	Decision         string // "BUY", "WAIT", "BYE"
	Summary          string
	Confidence       int
	KeyPoints        []string
	ProcessingTimeMs int64
}

func getQuickDecisionClasses(decision string) string {
	switch decision {
	case "BUY":
		return "border-green-500 bg-green-50 dark:bg-green-900/20 dark:border-green-400"
	case "WAIT":
		return "border-yellow-500 bg-yellow-50 dark:bg-yellow-900/20 dark:border-yellow-400"
	case "BYE":
		return "border-red-500 bg-red-50 dark:bg-red-900/20 dark:border-red-400"
	default:
		return "border-gray-300 bg-gray-50 dark:bg-gray-800 dark:border-gray-600"
	}
}

func getQuickDecisionTextColor(decision string) string {
	switch decision {
	case "BUY":
		return "text-green-800 dark:text-green-200"
	case "WAIT":
		return "text-yellow-800 dark:text-yellow-200"
	case "BYE":
		return "text-red-800 dark:text-red-200"
	default:
		return "text-gray-800 dark:text-gray-200"
	}
}

func getQuickDecisionDotColor(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-500"
	case "WAIT":
		return "bg-yellow-500"
	case "BYE":
		return "bg-red-500"
	default:
		return "bg-gray-400"
	}
}

func getQuickDecisionBadgeClass(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-100 text-green-800 dark:bg-green-800 dark:text-green-100"
	case "WAIT":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-100"
	case "BYE":
		return "bg-red-100 text-red-800 dark:bg-red-800 dark:text-red-100"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-100"
	}
}

func getQuickConfidenceBarColor(confidence int) string {
	if confidence >= 80 {
		return "bg-green-500"
	} else if confidence >= 60 {
		return "bg-yellow-500"
	} else {
		return "bg-red-500"
	}
}