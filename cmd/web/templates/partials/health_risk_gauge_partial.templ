package partials

import "fmt"

templ HealthRiskGaugePartial(riskData *HealthRiskDTO) {
	<div class="text-center" x-data="riskGauge()">
		<!-- Risk Score Gauge -->
		<div class="relative mx-auto mb-6" style="width: 200px; height: 120px;">
			<!-- Background Arc -->
			<svg class="absolute inset-0" width="200" height="120" viewBox="0 0 200 120">
				<defs>
					<linearGradient id="gaugeBackground" x1="0%" y1="0%" x2="100%" y2="0%">
						<stop offset="0%" style="stop-color:#10B981;stop-opacity:0.3" />
						<stop offset="50%" style="stop-color:#F59E0B;stop-opacity:0.3" />
						<stop offset="100%" style="stop-color:#EF4444;stop-opacity:0.3" />
					</linearGradient>
					<linearGradient id="gaugeForeground" x1="0%" y1="0%" x2="100%" y2="0%">
						<stop offset="0%" style="stop-color:#10B981" />
						<stop offset="50%" style="stop-color:#F59E0B" />
						<stop offset="100%" style="stop-color:#EF4444" />
					</linearGradient>
				</defs>
				<!-- Background arc -->
				<path 
					d="M 20 100 A 80 80 0 0 1 180 100" 
					stroke="url(#gaugeBackground)" 
					stroke-width="12" 
					fill="none"
					class="dark:opacity-40"
				/>
				<!-- Animated progress arc -->
				<path 
					id="risk-progress"
					d="M 20 100 A 80 80 0 0 1 180 100" 
					stroke="url(#gaugeForeground)" 
					stroke-width="12" 
					fill="none"
					stroke-linecap="round"
					:stroke-dasharray="circumference"
					:stroke-dashoffset="circumference - (circumference * animatedScore / 100)"
					class="transition-all duration-2000 ease-out"
					x-init="startAnimation()"
				/>
				
				<!-- Needle -->
				<g class="transition-transform duration-2000 ease-out" :style="`transform: rotate(${animatedScore * 1.8 - 90}deg); transform-origin: 100px 100px;`">
					<line x1="100" y1="100" x2="100" y2="40" stroke="#374151" stroke-width="3" stroke-linecap="round" class="dark:stroke-gray-300"/>
					<circle cx="100" cy="100" r="6" fill="#374151" class="dark:fill-gray-300"/>
				</g>
			</svg>
			
			<!-- Score Display -->
			<div class="absolute inset-0 flex flex-col items-center justify-end pb-2">
				<div 
					class="text-3xl font-bold transition-colors duration-1000"
					:class="getScoreColor(animatedScore)"
					x-text="Math.round(animatedScore)"
				>
					0
				</div>
				<div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
					Risk Score
				</div>
			</div>
		</div>

		<!-- Risk Level Label -->
		<div class="mb-6">
			<div 
				class="inline-flex px-4 py-2 rounded-full text-sm font-medium transition-colors duration-1000"
				:class="getRiskLevelClass(animatedScore)"
				x-text="getRiskLevelText(animatedScore)"
			>
				Loading...
			</div>
		</div>

		<!-- Risk Factors Breakdown -->
		<div class="space-y-4 text-left">
			<h4 class="text-sm font-medium text-gray-900 dark:text-white text-center mb-4">Risk Factors Breakdown</h4>
			
			for _, factor := range riskData.Factors {
				<div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
					<div class="flex items-center">
						<div class={ "w-3 h-3 rounded-full mr-3 " + getFactorColor(factor.Impact) }></div>
						<div>
							<div class="text-sm font-medium text-gray-900 dark:text-white">
								{ factor.Name }
							</div>
							<div class="text-xs text-gray-500 dark:text-gray-400">
								{ factor.Description }
							</div>
						</div>
					</div>
					<div class="flex items-center">
						<div 
							class={ "text-sm font-medium " + getFactorTextColor(factor.Impact) }
						>
							{ getFactorSign(factor.Impact) }{ factor.Points }
						</div>
						<div class="ml-2">
							<div class={ "w-6 h-6 rounded-full flex items-center justify-center text-xs font-medium text-white " + getFactorBgColor(factor.Impact) }>
								if factor.Impact == "high" {
									!
								} else if factor.Impact == "medium" {
									?
								} else {
									✓
								}
							</div>
						</div>
					</div>
				</div>
			}
			
			if len(riskData.Factors) == 0 {
				<div class="text-center py-8">
					<div class="text-gray-400 mb-2">
						<svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
					<div class="text-sm text-gray-500 dark:text-gray-400">
						No risk factors identified yet
					</div>
				</div>
			}
		</div>

		<!-- Recommendations -->
		if len(riskData.Recommendations) > 0 {
			<div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
				<h5 class="text-sm font-medium text-blue-900 dark:text-blue-300 mb-3">Recommendations</h5>
				<ul class="space-y-2">
					for _, rec := range riskData.Recommendations {
						<li class="flex items-start text-sm text-blue-800 dark:text-blue-300">
							<svg class="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							<span>{ rec }</span>
						</li>
					}
				</ul>
			</div>
		}
	</div>

	<script>
		function riskGauge() {
			return {
				targetScore: { riskData.Score },
				animatedScore: 0,
				circumference: 251.33, // Approximate circumference of the arc

				startAnimation() {
					let start = Date.now();
					const duration = 2500;
					
					const animate = () => {
						const elapsed = Date.now() - start;
						const progress = Math.min(elapsed / duration, 1);
						
						// Ease-out cubic function for smooth animation
						const easeOutCubic = 1 - Math.pow(1 - progress, 3);
						
						this.animatedScore = this.targetScore * easeOutCubic;
						
						if (progress < 1) {
							requestAnimationFrame(animate);
						} else {
							this.animatedScore = this.targetScore;
						}
					};
					
					// Start animation after a small delay
					setTimeout(() => requestAnimationFrame(animate), 300);
				},

				getScoreColor(score) {
					if (score <= 30) return 'text-green-600 dark:text-green-400';
					if (score <= 60) return 'text-yellow-600 dark:text-yellow-400';
					return 'text-red-600 dark:text-red-400';
				},

				getRiskLevelClass(score) {
					if (score <= 30) return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400';
					if (score <= 60) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400';
					return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400';
				},

				getRiskLevelText(score) {
					if (score <= 30) return 'Low Risk';
					if (score <= 60) return 'Moderate Risk';
					return 'High Risk';
				}
			}
		}
	</script>
}

type HealthRiskDTO struct {
	Score           int
	Level           string
	Factors         []RiskFactor
	Recommendations []string
	LastUpdated     string
}

type RiskFactor struct {
	Name        string
	Description string
	Points      int
	Impact      string // "low", "medium", "high"
	Category    string
}

func getFactorColor(impact string) string {
	switch impact {
	case "high":
		return "bg-red-500"
	case "medium":
		return "bg-yellow-500"
	case "low":
		return "bg-green-500"
	default:
		return "bg-gray-500"
	}
}

func getFactorTextColor(impact string) string {
	switch impact {
	case "high":
		return "text-red-600 dark:text-red-400"
	case "medium":
		return "text-yellow-600 dark:text-yellow-400"
	case "low":
		return "text-green-600 dark:text-green-400"
	default:
		return "text-gray-600 dark:text-gray-400"
	}
}

func getFactorBgColor(impact string) string {
	switch impact {
	case "high":
		return "bg-red-500"
	case "medium":
		return "bg-yellow-500"
	case "low":
		return "bg-green-500"
	default:
		return "bg-gray-500"
	}
}

func getFactorSign(impact string) string {
	switch impact {
	case "high", "medium":
		return "+"
	case "low":
		return "-"
	default:
		return ""
	}
}