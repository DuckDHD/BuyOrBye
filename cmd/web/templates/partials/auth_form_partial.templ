package partials

import "fmt"

templ AuthErrorDisplay(errors []string) {
	<div class="rounded-md bg-red-50 dark:bg-red-900/20 p-4 mb-4 border border-red-200 dark:border-red-800">
		<div class="flex">
			<div class="flex-shrink-0">
				<svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
				</svg>
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-red-800 dark:text-red-200">
					if len(errors) == 1 {
						There was an error with your submission
					} else {
						There were { fmt.Sprintf("%d", len(errors)) } errors with your submission
					}
				</h3>
				<div class="mt-2 text-sm text-red-700 dark:text-red-300">
					<ul class="list-disc pl-5 space-y-1">
						for _, error := range errors {
							<li>{ error }</li>
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
}

templ AuthFieldError(message string) {
	if message != "" {
		<p class="mt-1 text-sm text-red-600 dark:text-red-400">{ message }</p>
	}
}

templ AuthFieldSuccess(message string) {
	if message != "" {
		<p class="mt-1 text-sm text-green-600 dark:text-green-400">{ message }</p>
	}
}

templ AuthLoadingIndicator(id, loadingText string) {
	<span id={ id } class="htmx-indicator">
		<svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
			<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
			<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
		</svg>
		{ loadingText }
	</span>
}

templ EmailInput(id, name, placeholder, value string, required bool) {
	<div>
		<label for={ id } class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
			Email Address
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		<div class="relative">
			<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
				<svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
				</svg>
			</div>
			<input
				id={ id }
				name={ name }
				type="email"
				autocomplete="email"
				if required {
					required
				}
				class="appearance-none rounded-lg relative block w-full pl-10 px-3 py-2 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm transition-colors"
				placeholder={ placeholder }
				value={ value }
			/>
		</div>
		<div id={ id + "-error" } class="mt-1"></div>
	</div>
}

templ PasswordInput(id, name, placeholder, autocomplete string, required bool) {
	<div>
		<label for={ id } class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
			Password
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		<div class="relative" x-data="{ showPassword: false }">
			<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
				<svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
				</svg>
			</div>
			<input 
				id={ id }
				name={ name }
				:type="showPassword ? 'text' : 'password'"
				autocomplete={ autocomplete }
				if required {
					required
				}
				class="appearance-none rounded-lg relative block w-full pl-10 pr-10 px-3 py-2 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm transition-colors"
				placeholder={ placeholder }
			/>
			<button 
				type="button"
				class="absolute inset-y-0 right-0 pr-3 flex items-center"
				@click="showPassword = !showPassword"
			>
				<svg x-show="!showPassword" class="h-5 w-5 text-gray-400 hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
				</svg>
				<svg x-show="showPassword" class="h-5 w-5 text-gray-400 hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
				</svg>
			</button>
		</div>
		<div id={ id + "-error" } class="mt-1"></div>
	</div>
}

templ TextInput(id, name, label, placeholder, value string, required bool) {
	<div>
		<label for={ id } class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
			{ label }
			if required {
				<span class="text-red-500">*</span>
			}
		</label>
		<div class="relative">
			<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
				<svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
				</svg>
			</div>
			<input 
				id={ id }
				name={ name }
				type="text"
				if required {
					required
				}
				class="appearance-none rounded-lg relative block w-full pl-10 px-3 py-2 border border-gray-300 dark:border-gray-600 placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm transition-colors"
				placeholder={ placeholder }
				value={ value }
			/>
		</div>
		<div id={ id + "-error" } class="mt-1"></div>
	</div>
}

templ CheckboxInput(id, name, label string, checked, required bool) {
	<div class="flex items-start">
		<div class="flex items-center h-5">
			<input 
				id={ id }
				name={ name }
				type="checkbox"
				if required {
					required
				}
				if checked {
					checked
				}
				class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700"
			/>
		</div>
		<div class="ml-3 text-sm">
			<label for={ id } class="text-gray-700 dark:text-gray-300">
				{ label }
				if required {
					<span class="text-red-500">*</span>
				}
			</label>
		</div>
	</div>
}

templ SubmitButton(text, loadingText, loadingId string, icon string) {
	<button 
		type="submit" 
		class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
	>
		<span class="absolute left-0 inset-y-0 flex items-center pl-3">
			@AuthButtonIcon(icon)
		</span>
		@AuthLoadingIndicator(loadingId, loadingText)
		<span class="htmx-indicator-hide">{ text }</span>
	</button>
}

templ AuthButtonIcon(iconType string) {
	switch iconType {
		case "login":
			<svg class="h-5 w-5 text-blue-500 group-hover:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
			</svg>
		case "register":
			<svg class="h-5 w-5 text-blue-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
			</svg>
		case "reset":
			<svg class="h-5 w-5 text-blue-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
			</svg>
		default:
			<svg class="h-5 w-5 text-blue-500 group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
	}
}

templ SocialLoginButton(provider, iconSvg string, disabled bool) {
	<button 
		type="button"
		class="w-full inline-flex justify-center py-2 px-4 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm bg-white dark:bg-gray-700 text-sm font-medium text-gray-500 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
		if disabled {
			disabled
		}
	>
		{ iconSvg }
		<span class="ml-2">{ provider }</span>
	</button>
}

templ AuthDivider(text string) {
	<div class="mt-6">
		<div class="relative">
			<div class="absolute inset-0 flex items-center">
				<div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
			</div>
			<div class="relative flex justify-center text-sm">
				<span class="px-2 bg-gray-50 dark:bg-gray-900 text-gray-500 dark:text-gray-400">{ text }</span>
			</div>
		</div>
	</div>
}

templ ValidationMessage(fieldId, message, type_attr string) {
	<div 
		id={ fieldId + "-validation" }
		hx-swap-oob="innerHTML"
	>
		if message != "" {
			<p 
				class={ "mt-1 text-sm " + getValidationColor(type_attr) }
			>
				{ message }
			</p>
		}
	</div>
}

templ InlineValidationError(message string) {
	if message != "" {
		<div class="text-red-600 dark:text-red-400 text-sm mt-1">
			<div class="flex items-start">
				<svg class="w-4 h-4 mt-0.5 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
				</svg>
				<span>{ message }</span>
			</div>
		</div>
	}
}

templ InlineValidationSuccess(message string) {
	if message != "" {
		<div class="text-green-600 dark:text-green-400 text-sm mt-1">
			<div class="flex items-start">
				<svg class="w-4 h-4 mt-0.5 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
				</svg>
				<span>{ message }</span>
			</div>
		</div>
	}
}

func getValidationColor(type_attr string) string {
	switch type_attr {
	case "error":
		return "text-red-600 dark:text-red-400"
	case "success":
		return "text-green-600 dark:text-green-400"
	case "warning":
		return "text-yellow-600 dark:text-yellow-400"
	default:
		return "text-gray-600 dark:text-gray-400"
	}
}