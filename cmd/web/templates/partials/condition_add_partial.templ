package partials

import (
	"fmt"
	"github.com/a-h/templ"
)

templ ConditionAddPartial(condition *ConditionFormDTO, commonConditions []string) {
	<div class="p-6" x-data="conditionForm()" x-init="initForm()">
		<form 
			hx-post="/health/conditions"
			hx-target="#condition-form-container"
			hx-swap="innerHTML"
			hx-indicator="#condition-submit-spinner"
			@submit.prevent="submitForm"
		>
			<div class="space-y-6">
				<!-- Form Header -->
				<div class="flex items-center justify-between">
					<h3 class="text-lg font-medium text-gray-900 dark:text-white">
						if condition != nil && condition.ID != "" {
							Edit Medical Condition
						} else {
							Add Medical Condition
						}
					</h3>
					<button 
						type="button" 
						class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
						@click="closeModal()"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<!-- Condition Name with Autocomplete -->
				<div class="relative">
					<label for="condition-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						Condition Name <span class="text-red-500">*</span>
					</label>
					<div class="relative">
						<input 
							id="condition-name"
							name="name"
							type="text" 
							x-model="form.name"
							@input="filterSuggestions()"
							@focus="showSuggestions = true"
							@keydown.escape="showSuggestions = false"
							@keydown.arrow-down="navigateSuggestions(1)"
							@keydown.arrow-up="navigateSuggestions(-1)"
							@keydown.enter.prevent="selectSuggestion()"
							class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm placeholder-gray-400 focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
							placeholder="e.g., Hypertension, Diabetes Type 2, Asthma"
							autocomplete="off"
							required
						/>
						<!-- Autocomplete Dropdown -->
						<div 
							x-show="showSuggestions && filteredSuggestions.length > 0" 
							x-transition
							class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 shadow-lg max-h-60 rounded-md py-1 text-base ring-1 ring-black ring-opacity-5 overflow-auto focus:outline-none"
						>
							<template x-for="(suggestion, index) in filteredSuggestions" :key="suggestion">
								<div 
									class="relative cursor-pointer select-none py-2 pl-3 pr-9 hover:bg-gray-100 dark:hover:bg-gray-600"
									:class="index === selectedSuggestionIndex ? 'bg-red-100 dark:bg-red-900/30 text-red-900 dark:text-red-300' : 'text-gray-900 dark:text-white'"
									@click="selectSuggestionByIndex(index)"
									x-text="suggestion"
								></div>
							</template>
						</div>
					</div>
					<div x-show="errors.name" x-text="errors.name" class="mt-1 text-sm text-red-600 dark:text-red-400"></div>
				</div>

				<!-- Severity Selector -->
				<div>
					<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						Severity Level <span class="text-red-500">*</span>
					</label>
					<div class="grid grid-cols-3 gap-3">
						<button 
							type="button"
							class="flex items-center justify-center px-4 py-3 border rounded-lg text-sm font-medium transition-colors"
							:class="form.severity === 'mild' ? 'border-green-500 bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700'"
							@click="form.severity = 'mild'"
						>
							<div class="flex flex-col items-center">
								<div class="w-4 h-4 rounded-full bg-green-500 mb-1"></div>
								<span>Mild</span>
							</div>
						</button>
						<button 
							type="button"
							class="flex items-center justify-center px-4 py-3 border rounded-lg text-sm font-medium transition-colors"
							:class="form.severity === 'moderate' ? 'border-yellow-500 bg-yellow-50 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700'"
							@click="form.severity = 'moderate'"
						>
							<div class="flex flex-col items-center">
								<div class="w-4 h-4 rounded-full bg-yellow-500 mb-1"></div>
								<span>Moderate</span>
							</div>
						</button>
						<button 
							type="button"
							class="flex items-center justify-center px-4 py-3 border rounded-lg text-sm font-medium transition-colors"
							:class="form.severity === 'severe' ? 'border-red-500 bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-400' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700'"
							@click="form.severity = 'severe'"
						>
							<div class="flex flex-col items-center">
								<div class="w-4 h-4 rounded-full bg-red-500 mb-1"></div>
								<span>Severe</span>
							</div>
						</button>
					</div>
					<input type="hidden" name="severity" x-model="form.severity" required/>
					<div x-show="errors.severity" x-text="errors.severity" class="mt-1 text-sm text-red-600 dark:text-red-400"></div>
				</div>

				<!-- Diagnosed Date -->
				<div>
					<label for="diagnosed-date" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						Date Diagnosed
					</label>
					<input 
						id="diagnosed-date"
						name="diagnosed_date"
						type="date" 
						x-model="form.diagnosedDate"
						class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
					/>
					<div x-show="errors.diagnosed_date" x-text="errors.diagnosed_date" class="mt-1 text-sm text-red-600 dark:text-red-400"></div>
				</div>

				<!-- Medication Toggle and Details -->
				<div>
					<div class="flex items-center justify-between mb-4">
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
							Medication Required
						</label>
						<button
							type="button"
							class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
							:class="form.requiresMedication ? 'bg-red-600' : 'bg-gray-200 dark:bg-gray-600'"
							@click="form.requiresMedication = !form.requiresMedication"
						>
							<span 
								class="pointer-events-none inline-block h-5 w-5 rounded-full bg-white shadow transform ring-0 transition duration-200 ease-in-out"
								:class="form.requiresMedication ? 'translate-x-5' : 'translate-x-0'"
							></span>
						</button>
					</div>

					<!-- Medication Details (shown when toggle is on) -->
					<div x-show="form.requiresMedication" x-transition class="space-y-4">
						<div>
							<label for="medication-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
								Medication Name
							</label>
							<input 
								id="medication-name"
								name="medication_name"
								type="text" 
								x-model="form.medicationName"
								class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm placeholder-gray-400 focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
								placeholder="e.g., Lisinopril, Metformin"
							/>
						</div>

						<div class="grid grid-cols-2 gap-4">
							<div>
								<label for="medication-dosage" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
									Dosage
								</label>
								<input 
									id="medication-dosage"
									name="medication_dosage"
									type="text" 
									x-model="form.medicationDosage"
									class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm placeholder-gray-400 focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
									placeholder="e.g., 10mg, 500mg"
								/>
							</div>
							<div>
								<label for="medication-frequency" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
									Frequency
								</label>
								<select 
									id="medication-frequency"
									name="medication_frequency"
									x-model="form.medicationFrequency"
									class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
								>
									<option value="">Select frequency</option>
									<option value="once_daily">Once Daily</option>
									<option value="twice_daily">Twice Daily</option>
									<option value="three_times_daily">Three Times Daily</option>
									<option value="four_times_daily">Four Times Daily</option>
									<option value="as_needed">As Needed</option>
									<option value="weekly">Weekly</option>
									<option value="monthly">Monthly</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<!-- Monthly Cost (if applicable) -->
				<div x-show="form.requiresMedication" x-transition>
					<label for="monthly-cost" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						Estimated Monthly Cost
					</label>
					<div class="relative rounded-md shadow-sm">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<span class="text-gray-500 sm:text-sm">$</span>
						</div>
						<input 
							id="monthly-cost"
							name="monthly_cost"
							type="text"
							x-model="form.displayCost"
							@input="formatCost($event.target.value)"
							@blur="validateCost()"
							class="block w-full pl-7 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm placeholder-gray-400 focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
							placeholder="0.00"
						/>
					</div>
					<div x-show="errors.monthly_cost" x-text="errors.monthly_cost" class="mt-1 text-sm text-red-600 dark:text-red-400"></div>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Include medication, doctor visits, and related expenses
					</p>
				</div>

				<!-- Notes -->
				<div>
					<label for="condition-notes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						Notes <span class="text-xs text-gray-500">(Optional)</span>
					</label>
					<textarea 
						id="condition-notes"
						name="notes"
						x-model="form.notes"
						rows="3"
						class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm placeholder-gray-400 focus:ring-red-500 focus:border-red-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors resize-none"
						placeholder="Additional information about this condition..."
					></textarea>
				</div>
			</div>

			<!-- Form Actions -->
			<div class="flex justify-end space-x-3 mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
				<button 
					type="button"
					class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors"
					@click="closeModal()"
				>
					Cancel
				</button>
				<button 
					type="submit"
					class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
					:disabled="isSubmitting"
				>
					<span id="condition-submit-spinner" class="htmx-indicator">
						<svg class="animate-spin -ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
					</span>
					<span class="htmx-indicator-hide">
						if condition != nil && condition.ID != "" {
							Update Condition
						} else {
							Add Condition
						}
					</span>
				</button>
			</div>

			<!-- Hidden fields for editing -->
			if condition != nil && condition.ID != "" {
				<input type="hidden" name="id" value={ condition.ID }/>
			}
			<input type="hidden" name="requires_medication" x-model="form.requiresMedication"/>
			<input type="hidden" name="monthly_cost" x-model="form.monthlyCost"/>
		</form>
	</div>

	<script>
		function conditionForm() {
			return {
				form: {
					name: '',
					severity: '',
					diagnosedDate: '',
					requiresMedication: false,
					medicationName: '',
					medicationDosage: '',
					medicationFrequency: '',
					monthlyCost: 0,
					displayCost: '',
					notes: ''
				},
				errors: {},
				isSubmitting: false,
				
				// Autocomplete
				commonConditions: [
					for _, condition := range commonConditions {
						'{ condition }',
					}
				],
				showSuggestions: false,
				filteredSuggestions: [],
				selectedSuggestionIndex: -1,

				initForm() {
					// Initialize with existing data if editing
					if condition != nil && condition.Name != "" {
						this.form.name = { templ.JSONString(condition.Name) };
						this.form.severity = { templ.JSONString(condition.Severity) };
						this.form.diagnosedDate = { templ.JSONString(condition.DiagnosedDate) };
						this.form.requiresMedication = { condition.RequiresMedication };
						this.form.medicationName = { templ.JSONString(condition.MedicationName) };
						this.form.medicationDosage = { templ.JSONString(condition.MedicationDosage) };
						this.form.medicationFrequency = { templ.JSONString(condition.MedicationFrequency) };
						this.form.monthlyCost = { condition.MonthlyCost };
						this.form.displayCost = this.formatCurrency({ condition.MonthlyCost });
						this.form.notes = { templ.JSONString(condition.Notes) };
					}
					
					this.filteredSuggestions = this.commonConditions;
				},

				filterSuggestions() {
					if (this.form.name.length < 2) {
						this.filteredSuggestions = this.commonConditions;
						return;
					}
					
					this.filteredSuggestions = this.commonConditions.filter(condition =>
						condition.toLowerCase().includes(this.form.name.toLowerCase())
					);
					this.selectedSuggestionIndex = -1;
					this.showSuggestions = true;
				},

				navigateSuggestions(direction) {
					if (!this.showSuggestions || this.filteredSuggestions.length === 0) return;
					
					this.selectedSuggestionIndex += direction;
					
					if (this.selectedSuggestionIndex < 0) {
						this.selectedSuggestionIndex = this.filteredSuggestions.length - 1;
					} else if (this.selectedSuggestionIndex >= this.filteredSuggestions.length) {
						this.selectedSuggestionIndex = 0;
					}
				},

				selectSuggestion() {
					if (this.selectedSuggestionIndex >= 0 && this.selectedSuggestionIndex < this.filteredSuggestions.length) {
						this.form.name = this.filteredSuggestions[this.selectedSuggestionIndex];
						this.showSuggestions = false;
						this.selectedSuggestionIndex = -1;
						delete this.errors.name;
					}
				},

				selectSuggestionByIndex(index) {
					this.form.name = this.filteredSuggestions[index];
					this.showSuggestions = false;
					this.selectedSuggestionIndex = -1;
					delete this.errors.name;
				},

				formatCost(value) {
					let cleanValue = value.replace(/[^\d.]/g, '');
					
					let decimalCount = (cleanValue.match(/\./g) || []).length;
					if (decimalCount > 1) {
						let parts = cleanValue.split('.');
						cleanValue = parts[0] + '.' + parts.slice(1).join('');
					}

					if (cleanValue.includes('.')) {
						let parts = cleanValue.split('.');
						parts[1] = parts[1].substring(0, 2);
						cleanValue = parts[0] + '.' + parts[1];
					}

					this.form.displayCost = cleanValue;
					this.form.monthlyCost = parseFloat(cleanValue) || 0;
					
					if (this.form.monthlyCost >= 0) {
						delete this.errors.monthly_cost;
					}
				},

				validateCost() {
					if (this.form.monthlyCost < 0) {
						this.errors.monthly_cost = 'Cost cannot be negative';
						return false;
					}
					if (this.form.monthlyCost > 10000) {
						this.errors.monthly_cost = 'Cost seems unusually high, please verify';
						return false;
					}
					delete this.errors.monthly_cost;
					return true;
				},

				formatCurrency(amount) {
					if (!amount && amount !== 0) return '';
					return parseFloat(amount).toFixed(2);
				},

				validateForm() {
					this.errors = {};
					let isValid = true;

					if (!this.form.name.trim()) {
						this.errors.name = 'Condition name is required';
						isValid = false;
					}

					if (!this.form.severity) {
						this.errors.severity = 'Severity level is required';
						isValid = false;
					}

					if (!this.validateCost()) {
						isValid = false;
					}

					return isValid;
				},

				submitForm() {
					if (!this.validateForm()) {
						return;
					}

					this.isSubmitting = true;
					
					const formData = new FormData();
					formData.append('name', this.form.name);
					formData.append('severity', this.form.severity);
					formData.append('diagnosed_date', this.form.diagnosedDate);
					formData.append('requires_medication', this.form.requiresMedication);
					formData.append('medication_name', this.form.medicationName);
					formData.append('medication_dosage', this.form.medicationDosage);
					formData.append('medication_frequency', this.form.medicationFrequency);
					formData.append('monthly_cost', this.form.monthlyCost);
					formData.append('notes', this.form.notes);
					
					let url, method;
					if condition != nil && condition.ID != "" {
						formData.append('id', { templ.JSONString(condition.ID) });
						url = `/health/conditions/${ templ.JSONString(condition.ID) }`;
						method = 'PATCH';
					} else {
						url = '/health/conditions';
						method = 'POST';
					}

					htmx.ajax(method, url, {
						values: Object.fromEntries(formData),
						target: '#conditions-list',
						swap: 'outerHTML'
					}).then(() => {
						this.isSubmitting = false;
						document.dispatchEvent(new CustomEvent('conditionChanged'));
						this.showToast('Condition saved successfully!', 'success');
						this.closeModal();
					}).catch(() => {
						this.isSubmitting = false;
						this.showToast('Failed to save condition', 'error');
					});
				},

				closeModal() {
					const container = document.getElementById('modal-container');
					container.classList.add('hidden');
					container.innerHTML = '';
				},

				showToast(message, type) {
					document.dispatchEvent(new CustomEvent('show-toast', {
						detail: { message, type }
					}));
				}
			}
		}
	</script>
}

type ConditionFormDTO struct {
	ID                   string
	Name                 string
	Severity             string
	DiagnosedDate        string
	RequiresMedication   bool
	MedicationName       string
	MedicationDosage     string
	MedicationFrequency  string
	MonthlyCost          float64
	Notes                string
}