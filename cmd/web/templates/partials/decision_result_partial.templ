package partials

import "fmt"

templ DecisionResult(result *DecisionResultDTO) {
	<div 
		class="decision-reveal"
		x-data="decisionReveal()"
		x-init="startReveal()"
	>
		<!-- Animated Reveal Container -->
		<div 
			class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl overflow-hidden transform transition-all duration-1000"
			x-show="isVisible"
			x-transition:enter="transition ease-out duration-1000"
			x-transition:enter-start="opacity-0 scale-90 transform -translate-y-8"
			x-transition:enter-end="opacity-100 scale-100 transform translate-y-0"
		>
			<!-- Main Decision Display -->
			<div class={ "relative px-8 py-12 text-center " + getResultBackgroundClass(result.Decision) }>
				<!-- Animated Decision Badge -->
				<div 
					class="inline-flex items-center justify-center w-24 h-24 rounded-full mb-6 transform transition-all duration-1000"
					x-show="showDecision"
					x-transition:enter="transition ease-out duration-700 delay-300"
					x-transition:enter-start="opacity-0 scale-0 rotate-180"
					x-transition:enter-end="opacity-100 scale-100 rotate-0"
					:class="'{ getDecisionIconBg(result.Decision) }'"
				>
					@DecisionIcon(result.Decision)
				</div>

				<!-- Decision Text -->
				<div 
					x-show="showDecision"
					x-transition:enter="transition ease-out duration-500 delay-500"
					x-transition:enter-start="opacity-0 transform translate-y-4"
					x-transition:enter-end="opacity-100 transform translate-y-0"
				>
					<h1 class={ "text-4xl font-bold mb-2 " + getResultTextColor(result.Decision) }>
						{ result.Decision }
					</h1>
					<p class="text-xl text-gray-600 dark:text-gray-300 mb-4">
						{ result.ItemName }
					</p>
					<p class={ "text-lg font-medium " + getResultTextColor(result.Decision) }>
						{ result.Summary }
					</p>
				</div>

				<!-- Animated Confetti/Particles for BUY decision -->
				if result.Decision == "BUY" {
					<div class="absolute inset-0 pointer-events-none">
						<div class="confetti-container">
							for i := 0; i < 50; i++ {
								<div class="confetti" style={ getConfettiStyle(i) }></div>
							}
						</div>
					</div>
				}
			</div>

			<!-- Confidence Meter -->
			<div 
				class="px-8 py-6 border-t border-gray-200 dark:border-gray-700"
				x-show="showDetails"
				x-transition:enter="transition ease-out duration-500 delay-700"
				x-transition:enter-start="opacity-0 transform translate-y-4"
				x-transition:enter-end="opacity-100 transform translate-y-0"
			>
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white">AI Confidence</h3>
					<span class="text-2xl font-bold text-gray-900 dark:text-white" x-text="animatedConfidence + '%'">
						{ fmt.Sprintf("%d", result.Confidence) }%
					</span>
				</div>
				<div class="relative">
					<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-4 overflow-hidden">
						<div 
							class={ "h-full transition-all duration-2000 ease-out rounded-full " + getResultConfidenceBarColor(result.Confidence) }
							:style="`width: ${animatedConfidence}%`"
						></div>
					</div>
					<div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-1">
						<span>Low</span>
						<span>Medium</span>
						<span>High</span>
					</div>
				</div>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
					{ getConfidenceDescription(result.Confidence) }
				</p>
			</div>

			<!-- AI Reasoning Section -->
			<div 
				class="px-8 py-6 border-t border-gray-200 dark:border-gray-700"
				x-show="showDetails"
				x-transition:enter="transition ease-out duration-500 delay-900"
				x-transition:enter-start="opacity-0 transform translate-y-4"
				x-transition:enter-end="opacity-100 transform translate-y-0"
			>
				<button 
					type="button"
					class="flex items-center justify-between w-full text-left"
					@click="reasoningExpanded = !reasoningExpanded"
				>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white">AI Reasoning</h3>
					<svg 
						class="w-5 h-5 text-gray-500 transition-transform duration-200"
						:class="{ 'rotate-180': reasoningExpanded }"
						fill="none" 
						stroke="currentColor" 
						viewBox="0 0 24 24"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>

				<div 
					x-show="reasoningExpanded"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0 max-h-0"
					x-transition:enter-end="opacity-100 max-h-screen"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 max-h-screen"
					x-transition:leave-end="opacity-0 max-h-0"
					class="mt-4 overflow-hidden"
				>
					<div class="prose dark:prose-invert max-w-none">
						<p class="text-gray-700 dark:text-gray-300 leading-relaxed">
							{ result.Reasoning }
						</p>
					</div>
				</div>
			</div>

			<!-- Key Factors -->
			if len(result.KeyFactors) > 0 {
				<div 
					class="px-8 py-6 border-t border-gray-200 dark:border-gray-700"
					x-show="showDetails"
					x-transition:enter="transition ease-out duration-500 delay-1100"
					x-transition:enter-start="opacity-0 transform translate-y-4"
					x-transition:enter-end="opacity-100 transform translate-y-0"
				>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Key Factors Considered</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
						for i, factor := range result.KeyFactors {
							<div 
								class="flex items-start space-x-3 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg"
								x-show="true"
								x-transition:enter="transition ease-out duration-300"
								x-transition:enter-start="opacity-0 transform translate-x-4"
								x-transition:enter-end="opacity-100 transform translate-x-0"
								style={ fmt.Sprintf("transition-delay: %dms", (i+1)*100) }
							>
								<div class={ "w-2 h-2 rounded-full mt-2 flex-shrink-0 " + getFactorDotColor(i) }></div>
								<p class="text-sm text-gray-700 dark:text-gray-300">{ factor }</p>
							</div>
						}
					</div>
				</div>
			}

			<!-- Recommendations -->
			if len(result.Recommendations) > 0 {
				<div 
					class="px-8 py-6 border-t border-gray-200 dark:border-gray-700"
					x-show="showDetails"
					x-transition:enter="transition ease-out duration-500 delay-1300"
					x-transition:enter-start="opacity-0 transform translate-y-4"
					x-transition:enter-end="opacity-100 transform translate-y-0"
				>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recommendations</h3>
					<ul class="space-y-3">
						for i, recommendation := range result.Recommendations {
							<li 
								class="flex items-start space-x-3"
								x-show="true"
								x-transition:enter="transition ease-out duration-300"
								x-transition:enter-start="opacity-0 transform translate-x-4"
								x-transition:enter-end="opacity-100 transform translate-x-0"
								style={ fmt.Sprintf("transition-delay: %dms", (i+1)*150) }
							>
								<svg class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<p class="text-sm text-gray-700 dark:text-gray-300">{ recommendation }</p>
							</li>
						}
					</ul>
				</div>
			}

			<!-- Action Buttons -->
			<div 
				class={ "px-8 py-6 bg-gray-50 dark:bg-gray-700 flex flex-wrap gap-3 justify-center " + getActionBackgroundClass(result.Decision) }
				x-show="showActions"
				x-transition:enter="transition ease-out duration-500 delay-1500"
				x-transition:enter-start="opacity-0 transform translate-y-8"
				x-transition:enter-end="opacity-100 transform translate-y-0"
			>
				<!-- Save Decision -->
				<button 
					type="button"
					class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					hx-post="/decision/save"
					hx-vals={ `{"decision_id": "` + result.ID + `"}` }
					hx-target="this"
					hx-swap="outerHTML"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
					</svg>
					Save Decision
				</button>

				<!-- Try Again -->
				<button 
					type="button"
					class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-600 hover:bg-gray-50 dark:hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					onclick="window.location.reload()"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					Try Again
				</button>

				<!-- Share Decision -->
				<button 
					type="button"
					class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-600 hover:bg-gray-50 dark:hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					@click="shareDecision()"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
					</svg>
					Share
				</button>

				<!-- View Similar Decisions -->
				<a 
					href={ "/decisions?item=" + result.ItemName }
					class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-600 hover:bg-gray-50 dark:hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
					hx-boost="true"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					View Similar
				</a>
			</div>
		</div>

		<!-- Processing Time -->
		if result.ProcessingTimeMs > 0 {
			<div class="text-center mt-4">
				<p class="text-sm text-gray-500 dark:text-gray-400">
					Decision processed in { fmt.Sprintf("%d", result.ProcessingTimeMs) }ms
				</p>
			</div>
		}
	</div>

	<style>
		.decision-reveal {
			animation: slideUp 0.8s ease-out;
		}

		@keyframes slideUp {
			from {
				opacity: 0;
				transform: translateY(50px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.confetti-container {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			overflow: hidden;
		}

		.confetti {
			position: absolute;
			width: 6px;
			height: 6px;
			background: #f59e0b;
			animation: confetti-fall 3s ease-out infinite;
		}

		.confetti:nth-child(odd) {
			background: #10b981;
		}

		.confetti:nth-child(3n) {
			background: #3b82f6;
		}

		.confetti:nth-child(4n) {
			background: #f59e0b;
		}

		.confetti:nth-child(5n) {
			background: #ef4444;
		}

		@keyframes confetti-fall {
			0% {
				transform: translateY(-100vh) rotate(0deg);
				opacity: 1;
			}
			100% {
				transform: translateY(100vh) rotate(720deg);
				opacity: 0;
			}
		}
	</style>

	<script>
		function decisionReveal() {
			return {
				isVisible: false,
				showDecision: false,
				showDetails: false,
				showActions: false,
				reasoningExpanded: false,
				animatedConfidence: 0,
				targetConfidence: { result.Confidence },

				startReveal() {
					// Staggered reveal animation
					setTimeout(() => {
						this.isVisible = true;
						setTimeout(() => {
							this.showDecision = true;
							this.animateConfidence();
							setTimeout(() => {
								this.showDetails = true;
								setTimeout(() => {
									this.showActions = true;
								}, 200);
							}, 300);
						}, 500);
					}, 100);
				},

				animateConfidence() {
					const duration = 2000;
					const steps = 60;
					const increment = this.targetConfidence / steps;
					const stepDuration = duration / steps;
					
					let currentStep = 0;
					const timer = setInterval(() => {
						currentStep++;
						this.animatedConfidence = Math.min(Math.round(increment * currentStep), this.targetConfidence);
						
						if (currentStep >= steps || this.animatedConfidence >= this.targetConfidence) {
							clearInterval(timer);
							this.animatedConfidence = this.targetConfidence;
						}
					}, stepDuration);
				},

				shareDecision() {
					const shareData = {
						title: 'My BuyOrBye Decision',
						text: `I got a ${ result.Decision } recommendation for ${ result.ItemName } with ${ result.Confidence }% confidence from AI.`,
						url: window.location.href
					};

					if (navigator.share) {
						navigator.share(shareData);
					} else {
						// Fallback: copy to clipboard
						navigator.clipboard.writeText(shareData.text + ' ' + shareData.url).then(() => {
							Alpine.store('toast').success('Decision details copied to clipboard!');
						});
					}
				}
			}
		}
	</script>
}

templ DecisionIcon(decision string) {
	switch decision {
		case "BUY":
			<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
			</svg>
		case "WAIT":
			<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "BYE":
			<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		default:
			<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
	}
}

type DecisionResultDTO struct {
	ID                string
	ItemName          string
	Decision          string // "BUY", "WAIT", "BYE"
	Summary           string
	Confidence        int
	Reasoning         string
	KeyFactors        []string
	Recommendations   []string
	ProcessingTimeMs  int64
}

func getResultBackgroundClass(decision string) string {
	switch decision {
	case "BUY":
		return "bg-gradient-to-br from-green-500 to-green-600 text-white"
	case "WAIT":
		return "bg-gradient-to-br from-yellow-500 to-yellow-600 text-white"
	case "BYE":
		return "bg-gradient-to-br from-red-500 to-red-600 text-white"
	default:
		return "bg-gradient-to-br from-gray-500 to-gray-600 text-white"
	}
}

func getResultTextColor(decision string) string {
	return "text-white" // All decisions use white text on colored backgrounds
}

func getDecisionIconBg(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-600 shadow-green-300"
	case "WAIT":
		return "bg-yellow-600 shadow-yellow-300"
	case "BYE":
		return "bg-red-600 shadow-red-300"
	default:
		return "bg-gray-600 shadow-gray-300"
	}
}

func getResultConfidenceBarColor(confidence int) string {
	if confidence >= 80 {
		return "bg-green-500"
	} else if confidence >= 60 {
		return "bg-yellow-500"
	} else {
		return "bg-red-500"
	}
}

func getConfidenceDescription(confidence int) string {
	if confidence >= 90 {
		return "Very high confidence - The AI is very certain about this recommendation."
	} else if confidence >= 75 {
		return "High confidence - The AI has good certainty about this recommendation."
	} else if confidence >= 60 {
		return "Medium confidence - The AI has moderate certainty about this recommendation."
	} else if confidence >= 40 {
		return "Lower confidence - The AI has some uncertainty about this recommendation."
	} else {
		return "Low confidence - The AI has significant uncertainty about this recommendation."
	}
}

func getActionBackgroundClass(decision string) string {
	switch decision {
	case "BUY":
		return "border-t-green-200 dark:border-t-green-800"
	case "WAIT":
		return "border-t-yellow-200 dark:border-t-yellow-800"
	case "BYE":
		return "border-t-red-200 dark:border-t-red-800"
	default:
		return "border-t-gray-200 dark:border-t-gray-800"
	}
}

func getFactorDotColor(index int) string {
	colors := []string{
		"bg-blue-500",
		"bg-green-500",
		"bg-purple-500",
		"bg-yellow-500",
		"bg-red-500",
		"bg-indigo-500",
		"bg-pink-500",
		"bg-orange-500",
	}
	return colors[index%len(colors)]
}

func getConfettiStyle(index int) string {
	left := (index * 7) % 100
	delay := (index * 100) % 3000
	duration := 2000 + (index*200)%2000
	return fmt.Sprintf("left: %d%%; animation-delay: %dms; animation-duration: %dms;", left, delay, duration)
}