package partials

import "github.com/DuckDHD/BuyOrBye/internal/types"
import "fmt"

templ DecisionFilters(filters *types.DecisionFiltersDTO) {
	<div x-data="filterControls()" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
		<!-- Decision Type Filter -->
		<div>
			<label for="decision-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
				Decision Type
			</label>
			<select 
				id="decision-filter"
				name="decision"
				class="filter-input block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
				hx-get="/decisions"
				hx-target="#decisions-list"
				hx-swap="innerHTML"
				hx-trigger="change"
				hx-include="#search, .filter-input"
				hx-indicator="#filter-loading"
				x-model="filters.decision"
			>
				<option value="">All Decisions</option>
				<option value="BUY" if filters.Decision == "BUY" { selected }>BUY</option>
				<option value="WAIT" if filters.Decision == "WAIT" { selected }>WAIT</option>
				<option value="BYE" if filters.Decision == "BYE" { selected }>BYE</option>
			</select>
		</div>

		<!-- Category Filter -->
		<div>
			<label for="category-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
				Category
			</label>
			<select 
				id="category-filter"
				name="category"
				class="filter-input block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
				hx-get="/decisions"
				hx-target="#decisions-list"
				hx-swap="innerHTML"
				hx-trigger="change"
				hx-include="#search, .filter-input"
				hx-indicator="#filter-loading"
				x-model="filters.category"
			>
				<option value="">All Categories</option>
				<option value="Electronics" if filters.Category == "Electronics" { selected }>Electronics</option>
				<option value="Clothing" if filters.Category == "Clothing" { selected }>Clothing</option>
				<option value="Home" if filters.Category == "Home" { selected }>Home & Garden</option>
				<option value="Sports" if filters.Category == "Sports" { selected }>Sports & Fitness</option>
				<option value="Books" if filters.Category == "Books" { selected }>Books & Media</option>
				<option value="Food" if filters.Category == "Food" { selected }>Food & Beverages</option>
				<option value="Travel" if filters.Category == "Travel" { selected }>Travel</option>
				<option value="Health" if filters.Category == "Health" { selected }>Health & Beauty</option>
				<option value="Other" if filters.Category == "Other" { selected }>Other</option>
			</select>
		</div>

		<!-- Date Range -->
		<div>
			<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
				Date Range
			</label>
			<div class="flex space-x-2">
				<input 
					type="date"
					name="date_from"
					class="filter-input block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
					placeholder="From"
					value={ filters.DateFrom }
					hx-get="/decisions"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					hx-trigger="change"
					hx-include="#search, .filter-input"
					hx-indicator="#filter-loading"
					x-model="filters.dateFrom"
				/>
				<input 
					type="date"
					name="date_to"
					class="filter-input block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
					placeholder="To"
					value={ filters.DateTo }
					hx-get="/decisions"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					hx-trigger="change"
					hx-include="#search, .filter-input"
					hx-indicator="#filter-loading"
					x-model="filters.dateTo"
				/>
			</div>
		</div>

		<!-- Cost Range -->
		<div>
			<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
				Cost Range ($)
			</label>
			<div class="flex space-x-2">
				<input 
					type="number"
					name="min_cost"
					step="0.01"
					min="0"
					class="filter-input block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
					placeholder="Min"
					value={ filters.MinCost }
					hx-get="/decisions"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					hx-trigger="change delay:500ms"
					hx-include="#search, .filter-input"
					hx-indicator="#filter-loading"
					x-model="filters.minCost"
				/>
				<input 
					type="number"
					name="max_cost"
					step="0.01"
					min="0"
					class="filter-input block w-full rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
					placeholder="Max"
					value={ filters.MaxCost }
					hx-get="/decisions"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					hx-trigger="change delay:500ms"
					hx-include="#search, .filter-input"
					hx-indicator="#filter-loading"
					x-model="filters.maxCost"
				/>
			</div>
		</div>

		<!-- Sort Controls -->
		<div class="md:col-span-2">
			<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
				Sort By
			</label>
			<div class="flex space-x-2">
				<select 
					name="sort_by"
					class="filter-input block flex-1 rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
					hx-get="/decisions"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					hx-trigger="change"
					hx-include="#search, .filter-input"
					hx-indicator="#filter-loading"
					x-model="filters.sortBy"
				>
					<option value="created_at" if filters.SortBy == "created_at" { selected }>Date Created</option>
					<option value="item_name" if filters.SortBy == "item_name" { selected }>Item Name</option>
					<option value="cost" if filters.SortBy == "cost" { selected }>Cost</option>
					<option value="confidence" if filters.SortBy == "confidence" { selected }>Confidence</option>
					<option value="decision" if filters.SortBy == "decision" { selected }>Decision Type</option>
				</select>
				<select 
					name="sort_order"
					class="filter-input block rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-700 focus:border-blue-500 focus:ring-blue-500 text-sm transition-colors"
					hx-get="/decisions"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					hx-trigger="change"
					hx-include="#search, .filter-input"
					hx-indicator="#filter-loading"
					x-model="filters.sortOrder"
				>
					<option value="desc" if filters.SortOrder == "desc" { selected }>Newest First</option>
					<option value="asc" if filters.SortOrder == "asc" { selected }>Oldest First</option>
				</select>
			</div>
		</div>

		<!-- Filter Actions -->
		<div class="flex items-end space-x-2">
			<!-- Clear Filters -->
			<button 
				type="button"
				class="inline-flex items-center px-3 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				@click="clearAllFilters()"
			>
				<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
				Clear
			</button>

			<!-- Apply Filters (for mobile) -->
			<button 
				type="button"
				class="md:hidden inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
				hx-get="/decisions"
				hx-target="#decisions-list"
				hx-swap="innerHTML"
				hx-include="#search, .filter-input"
				hx-indicator="#filter-loading"
			>
				<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
				</svg>
				Apply
			</button>
		</div>

		<!-- Loading Indicator -->
		<div class="md:col-span-4 flex justify-center">
			<div id="filter-loading" class="htmx-indicator">
				<div class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
					<svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					<span>Filtering results...</span>
				</div>
			</div>
		</div>
	</div>

	<script>
		function filterControls() {
			return {
				filters: {
					decision: '{ filters.Decision }',
					category: '{ filters.Category }',
					dateFrom: '{ filters.DateFrom }',
					dateTo: '{ filters.DateTo }',
					minCost: '{ filters.MinCost }',
					maxCost: '{ filters.MaxCost }',
					sortBy: '{ filters.SortBy }',
					sortOrder: '{ filters.SortOrder }'
				},

				clearAllFilters() {
					// Reset all filter values
					this.filters = {
						decision: '',
						category: '',
						dateFrom: '',
						dateTo: '',
						minCost: '',
						maxCost: '',
						sortBy: 'created_at',
						sortOrder: 'desc'
					};

					// Clear search input
					const searchInput = document.querySelector('#search');
					if (searchInput) {
						searchInput.value = '';
					}

					// Reset all form inputs
					const filterInputs = document.querySelectorAll('.filter-input');
					filterInputs.forEach(input => {
						if (input.type === 'select-one') {
							input.selectedIndex = 0;
						} else {
							input.value = '';
						}
					});

					// Trigger refresh
					htmx.trigger('#decisions-list', 'refresh');
					
					// Dispatch event
					document.dispatchEvent(new CustomEvent('filterChanged'));
				},

				hasActiveFilters() {
					const searchValue = document.querySelector('#search')?.value || '';
					return searchValue !== '' || 
						   this.filters.decision !== '' ||
						   this.filters.category !== '' ||
						   this.filters.dateFrom !== '' ||
						   this.filters.dateTo !== '' ||
						   this.filters.minCost !== '' ||
						   this.filters.maxCost !== '' ||
						   (this.filters.sortBy !== 'created_at' || this.filters.sortOrder !== 'desc');
				},

				init() {
					// Watch for filter changes
					this.$watch('filters', () => {
						document.dispatchEvent(new CustomEvent('filterChanged'));
					}, { deep: true });
				}
			}
		}
	</script>
}

templ DecisionsList(decisions []DecisionItemDTO, viewMode string) {
	if len(decisions) == 0 {
		<div class="text-center py-12">
			<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-white">No decisions found</h3>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
				Try adjusting your search terms or filters.
			</p>
			<div class="mt-6">
				<a 
					href="/decisions/new"
					class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
					hx-boost="true"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
					Create New Decision
				</a>
			</div>
		</div>
	} else {
		if viewMode == "grid" {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
				for _, decision := range decisions {
					@DecisionGridItem(decision)
				}
			</div>
		} else {
			<div class="divide-y divide-gray-200 dark:divide-gray-700">
				for _, decision := range decisions {
					@DecisionListItem(decision)
				}
			</div>
		}
	}
}

templ DecisionListItem(decision DecisionItemDTO) {
	<div class="flex items-center justify-between p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
		<div class="flex items-center space-x-4 flex-1 min-w-0">
			<!-- Decision Indicator -->
			<div class={ "w-4 h-4 rounded-full flex-shrink-0 " + getDecisionIndicatorColor(decision.Decision) }></div>
			
			<!-- Content -->
			<div class="flex-1 min-w-0">
				<div class="flex items-center space-x-3">
					<h3 class="text-sm font-medium text-gray-900 dark:text-white truncate">
						{ decision.ItemName }
					</h3>
					<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium " + getDecisionBadgeClass(decision.Decision) }>
						{ decision.Decision }
					</span>
				</div>
				<div class="mt-1 flex items-center space-x-4 text-xs text-gray-500 dark:text-gray-400">
					<span>${ formatFilterCurrency(decision.Cost) }</span>
					if decision.Category != "" {
						<span>{ decision.Category }</span>
					}
					<span>{ decision.CreatedAt }</span>
					<span>{ decision.Confidence }% confidence</span>
				</div>
			</div>
		</div>

		<!-- Actions -->
		<div class="flex items-center space-x-2">
			<a 
				href={ "/decisions/" + decision.ID }
				class="text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
				hx-boost="true"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
				</svg>
			</a>
		</div>
	</div>
}

templ DecisionGridItem(decision DecisionItemDTO) {
	<div class={ "bg-white dark:bg-gray-800 rounded-lg shadow border-l-4 hover:shadow-md transition-shadow " + getDecisionBorderColor(decision.Decision) }>
		<div class="p-4">
			<div class="flex items-start justify-between">
				<div class="flex-1 min-w-0">
					<h3 class="text-sm font-medium text-gray-900 dark:text-white truncate">
						{ decision.ItemName }
					</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						${ formatFilterCurrency(decision.Cost) }
					</p>
				</div>
				<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium " + getDecisionBadgeClass(decision.Decision) }>
					{ decision.Decision }
				</span>
			</div>
			
			<div class="mt-3">
				<div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
					<span>{ decision.Confidence }% confidence</span>
					<span>{ decision.CreatedAt }</span>
				</div>
			</div>
			
			<div class="mt-3 flex justify-between items-center">
				if decision.Category != "" {
					<span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
						{ decision.Category }
					</span>
				} else {
					<div></div>
				}
				
				<a 
					href={ "/decisions/" + decision.ID }
					class="text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
					hx-boost="true"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
}

templ DecisionsPagination(currentPage, totalPages, totalItems int) {
	<div class="flex items-center justify-between">
		<div class="text-sm text-gray-700 dark:text-gray-300">
			<p>
				Showing page { fmt.Sprintf("%d", currentPage) } of { fmt.Sprintf("%d", totalPages) } 
				({ fmt.Sprintf("%d", totalItems) } total decisions)
			</p>
		</div>
		
		if totalPages > 1 {
			<nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
				<!-- Previous Page -->
				<button 
					class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed"
					hx-get="/decisions"
					hx-vals={ `{"page": "` + fmt.Sprintf("%d", max(1, currentPage-1)) + `"}` }
					hx-include="#search, .filter-input"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					if currentPage <= 1 {
						disabled
					}
				>
					<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
					</svg>
				</button>

				<!-- Page Numbers -->
				for page := max(1, currentPage-2); page <= min(totalPages, currentPage+2); page++ {
					<button 
						class={ "relative inline-flex items-center px-4 py-2 border text-sm font-medium " + getPaginationButtonClass(page, currentPage) }
						hx-get="/decisions"
						hx-vals={ `{"page": "` + fmt.Sprintf("%d", page) + `"}` }
						hx-include="#search, .filter-input"
						hx-target="#decisions-list"
						hx-swap="innerHTML"
					>
						{ fmt.Sprintf("%d", page) }
					</button>
				}

				<!-- Next Page -->
				<button 
					class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600 disabled:opacity-50 disabled:cursor-not-allowed"
					hx-get="/decisions"
					hx-vals={ `{"page": "` + fmt.Sprintf("%d", min(totalPages, currentPage+1)) + `"}` }
					hx-include="#search, .filter-input"
					hx-target="#decisions-list"
					hx-swap="innerHTML"
					if currentPage >= totalPages {
						disabled
					}
				>
					<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
					</svg>
				</button>
			</nav>
		}
	</div>
}

type DecisionItemDTO struct {
	ID         string
	ItemName   string
	Decision   string
	Cost       float64
	Category   string
	Confidence int
	CreatedAt  string
}

func getDecisionIndicatorColor(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-500"
	case "WAIT":
		return "bg-yellow-500"
	case "BYE":
		return "bg-red-500"
	default:
		return "bg-gray-400"
	}
}

func getDecisionBorderColor(decision string) string {
	switch decision {
	case "BUY":
		return "border-green-500"
	case "WAIT":
		return "border-yellow-500"
	case "BYE":
		return "border-red-500"
	default:
		return "border-gray-300"
	}
}

func getDecisionBadgeClass(decision string) string {
	switch decision {
	case "BUY":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "WAIT":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	case "BYE":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300"
	}
}

func getPaginationButtonClass(page, currentPage int) string {
	if page == currentPage {
		return "z-10 bg-blue-50 border-blue-500 text-blue-600 dark:bg-blue-900 dark:border-blue-400 dark:text-blue-300"
	}
	return "bg-white border-gray-300 text-gray-500 hover:bg-gray-50 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-600"
}

func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func formatFilterCurrency(amount float64) string {
	return fmt.Sprintf("%.2f", amount)
}